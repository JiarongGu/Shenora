<Project Sdk="Microsoft.NET.Sdk">
  <!-- Occlusion-IMMUNE window capture via Windows.Graphics.Capture (WGC). Unlike DXGI desktop-
       duplication (which grabs whatever is on screen → wrong when another window covers the host), WGC
       captures a SPECIFIC window's own composited content regardless of z-order — so it works even when
       the target app is UNDER the agent's console. Captures the WebView2 UI (DWM composes child windows
       into the captured window). Dev tool — never shipped in the app build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>wgc-shot</AssemblyName>
  </PropertyGroup>
  <!-- Zero NuGet deps: D3D11CreateDevice is P/Invoked directly; WGC + PNG encode come from the
       Windows SDK WinRT projections (auto-generated by the net10.0-windows TFM). -->

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Background native MOUSE input to the target app window via Win32 PostMessage (FindWindow +
       PostMessage to a background HWND + a WM_ACTIVATE wake — no real cursor move, no focus steal,
       occlusion-immune). Lets the agent drive the WebView2 UI for desktop verification when there's no
       CDP to reach it. Dev tool — never shipped in the app build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- BOM-less UTF-8 sources on a CJK-locale machine mojibake without this (csc reads them as
         ANSI) — these files carry non-ASCII characters in user-facing strings. -->
    <CodePage>65001</CodePage>
    <AssemblyName>win-input</AssemblyName>
  </PropertyGroup>
</Project>

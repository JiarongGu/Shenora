<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Required for ActivityKit: without it Activity.request fails and the reason is not obvious. It is
	     the APP's declaration, not the kit's, and the kit cannot add it for you — no MSBuild item merges a
	     key into this file. ⚠ Editing it does not reach an INCREMENTAL build either, because
	     _WriteAppManifest merges a stale obj/**/AppManifest.plist copy; see mobile-shells.md. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- 🔴 BACKGROUND AUDIO, and it is HALF of a pair — neither half works alone.
	     Without this key iOS suspends the process the moment the app leaves the foreground and playback
	     stops mid-sentence; without an ACTIVE AVAudioSession (see PlaybackSessionProbe) the key buys
	     nothing, because the system does not believe the app is playing anything.
	     ⚠ The symptom of missing either one is identical and says nothing about which: audio plays
	     perfectly in the foreground and dies on the swipe. Measured on a device, 2026-08-07.
	     Same caveat as the key above: this is the APP's declaration, the kit cannot add it, and editing
	     this file does not reach an INCREMENTAL build. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <!--
      x64 FIRST and explicitly. The emulator this is proven on is x86_64, and a default Android build
      can produce arm64 only — the APK then installs with INSTALL_FAILED_NO_MATCHING_ABIS, which reads
      like a packaging fault rather than "you built the wrong architecture". arm64 stays for a real
      phone.
    -->
    <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>

    <OutputType>Exe</OutputType>
    <RootNamespace>Shenora.Sample.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Never packable, like every other sample — it is the proof, not a product. -->
    <IsPackable>false</IsPackable>
    <!-- XML docs are a PACKAGE concern; a sample would only be noise under CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      The cold-start levers from the mobile plan's §6, strongest first. Release only: they cost
      minutes of build time, and a debug loop that slow stops being a loop.

        RunAOTCompilation + AndroidEnableProfiledAot — AOT-compile the RECORDED startup path rather
          than everything. §6 calls this the largest single win, and it is the one measured below.
        AndroidStripILAfterAOT — drop the IL that AOT replaced; size, not speed.
        PublishTrimmed — the main SIZE lever, and the reason IpcJson.AddTypeInfoResolver exists: a
          trimmed build strips the metadata a reflection-based JSON resolver needs.

      Measured on an emulator (see `dev.mjs android bench`), which compares builds against each other
      and is NOT a claim about a phone.
    -->
    <ApplicationTitle>Shenora Sample</ApplicationTitle>
    <ApplicationId>com.shenora.sample.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!--
      The splash colour MATCHES the page's background (#14161a), which is the kit's no-white-flash
      contract applied to this shell. §6 of the mobile plan lists perceived startup as a real lever
      and it is the cheapest one here: the template's purple splash handed over to a page painted
      near-black, so every launch flashed. Runtime init behind an already-correct colour is a
      different experience from the same milliseconds spent watching the colour change.
    -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14161A" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <!-- The web bundle. HybridWebView serves Resources/Raw/wwwroot as its HybridRoot — the platform
         does the serving, which is why the kit's resource-provider layer has no role on this shell. -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shenora.Maui\Shenora.Maui.csproj" />
    <!-- The SAME portable logic the desktop sample hosts. That shared reference is the point of the
         whole exercise: D20's portability stops being a claim about a net10.0 project and becomes two
         shells running one facade. -->
    <ProjectReference Include="..\Shenora.Sample.Logic\Shenora.Sample.Logic.csproj" />
  </ItemGroup>

</Project>

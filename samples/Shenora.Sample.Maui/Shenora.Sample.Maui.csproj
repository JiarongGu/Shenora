<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <!--
      x64 FIRST and explicitly. The emulator this is proven on is x86_64, and a default Android build
      can produce arm64 only — the APK then installs with INSTALL_FAILED_NO_MATCHING_ABIS, which reads
      like a packaging fault rather than "you built the wrong architecture". arm64 stays for a real
      phone.
    -->
    <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>

    <OutputType>Exe</OutputType>
    <RootNamespace>Shenora.Sample.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Never packable, like every other sample — it is the proof, not a product. -->
    <IsPackable>false</IsPackable>
    <!-- XML docs are a PACKAGE concern; a sample would only be noise under CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <ApplicationTitle>Shenora Sample</ApplicationTitle>
    <ApplicationId>com.shenora.sample.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <!-- The web bundle. HybridWebView serves Resources/Raw/wwwroot as its HybridRoot — the platform
         does the serving, which is why the kit's resource-provider layer has no role on this shell. -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shenora.Maui\Shenora.Maui.csproj" />
    <!-- The SAME portable logic the desktop sample hosts. That shared reference is the point of the
         whole exercise: D20's portability stops being a claim about a net10.0 project and becomes two
         shells running one facade. -->
    <ProjectReference Include="..\Shenora.Sample.Logic\Shenora.Sample.Logic.csproj" />
  </ItemGroup>

</Project>

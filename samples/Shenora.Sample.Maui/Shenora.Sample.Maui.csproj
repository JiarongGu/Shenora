<Project Sdk="Microsoft.NET.Sdk">

  <!-- TFM follows the HOST — see the same note in src/Shenora.Mobile/Shenora.Mobile.csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <!--
      x64 FIRST and explicitly. The emulator this is proven on is x86_64, and a default Android build
      can produce arm64 only — the APK then installs with INSTALL_FAILED_NO_MATCHING_ABIS, which reads
      like a packaging fault rather than "you built the wrong architecture". arm64 stays for a real
      phone.

      iOS has exactly the same trap and `dev.mjs mac` handles it the same way: the simulator RID
      follows the MAC's architecture (iossimulator-x64 on Intel, -arm64 on Apple Silicon), asked over
      ssh rather than assumed, and passed on the build command line.
    -->
    <RuntimeIdentifiers Condition="$(TargetFramework.Contains('android'))">android-x64;android-arm64</RuntimeIdentifiers>

    <OutputType>Exe</OutputType>
    <RootNamespace>Shenora.Sample.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Never packable, like every other sample — it is the proof, not a product. -->
    <IsPackable>false</IsPackable>
    <!-- XML docs are a PACKAGE concern; a sample would only be noise under CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      The cold-start levers from the mobile plan's §6, strongest first. Release only: they cost
      minutes of build time, and a debug loop that slow stops being a loop.

        RunAOTCompilation + AndroidEnableProfiledAot — AOT-compile the RECORDED startup path rather
          than everything. §6 calls this the largest single win, and it is the one measured below.
        AndroidStripILAfterAOT — drop the IL that AOT replaced; size, not speed.
        PublishTrimmed — the main SIZE lever, and the reason IpcJson.AddTypeInfoResolver exists: a
          trimmed build strips the metadata a reflection-based JSON resolver needs.

      Measured on an emulator (see `dev.mjs android bench`), which compares builds against each other
      and is NOT a claim about a phone.
    -->
    <ApplicationTitle>Shenora Sample</ApplicationTitle>
    <ApplicationId>com.shenora.sample.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!--
      The splash colour MATCHES the page's background (#14161a), which is the kit's no-white-flash
      contract applied to this shell. §6 of the mobile plan lists perceived startup as a real lever
      and it is the cheapest one here: the template's purple splash handed over to a page painted
      near-black, so every launch flashed. Runtime init behind an already-correct colour is a
      different experience from the same milliseconds spent watching the colour change.
    -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14161A" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <!-- The web bundle. HybridWebView serves Resources/Raw/wwwroot as its HybridRoot — the platform
         does the serving, which is why the kit's resource-provider layer has no role on this shell. -->
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\wwwroot\media\**"
               LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!--
      The REAL shipped client transport, served beside the page so the sample exercises
      `@shenora/react`'s own code rather than a hand-written copy of it. dist/transport.js compiles
      to dependency-free ESM (it imports nothing), which is the only reason this can be a plain file
      drop instead of a bundler.
      Conditional, and the page falls back if it is absent: a fresh clone has no dist/ until the npm
      package is built, and a sample that cannot build until you have run something else is a worse
      sample. `dev.mjs verify` builds it, so the proof path is the normal path.
    -->
    <MauiAsset Include="..\..\src\Shenora.React\dist\transport.js"
               LogicalName="wwwroot/shenora/transport.js"
               Condition="Exists('..\..\src\Shenora.React\dist\transport.js')" />
    <!--
      The SHIPPED mediaUrl(), for the same reason transport.js is here: the sample should exercise the
      published package's own code rather than a hand-written copy of it. The page hand-rolled this encoding
      for one commit and immediately drifted from the host route — which is exactly the class of bug a
      sample using the real thing cannot have.
    -->
    <MauiAsset Include="..\..\src\Shenora.React\dist\media.js"
               LogicalName="wwwroot/shenora/media.js"
               Condition="Exists('..\..\src\Shenora.React\dist\media.js')" />
    <!--
      The SHIPPED segment binder and the pure half it imports (D71 piece 4b). BOTH are needed and the
      pair is not optional: `segmentBinder.js` does `import … from './segmentStream.js'`, so the two
      must land in the SAME directory for the browser to resolve it — a lone binder throws on load.

      🔴 Here for D63's reason rather than for convenience. The page drove a MediaSource with its own
      inline copy of this logic through every device run so far, so the shipped module had never been
      executed on a device at all — and a seam nothing consults is indistinguishable from a broken one.
      The hand-written probe STAYS as the control: it is what proved the bytes independently of the
      kit's module, so if the two ever disagree, the disagreement is the finding.
    -->
    <MauiAsset Include="..\..\src\Shenora.React\dist\segmentStream.js"
               LogicalName="wwwroot/shenora/segmentStream.js"
               Condition="Exists('..\..\src\Shenora.React\dist\segmentStream.js')" />
    <MauiAsset Include="..\..\src\Shenora.React\dist\segmentBinder.js"
               LogicalName="wwwroot/shenora/segmentBinder.js"
               Condition="Exists('..\..\src\Shenora.React\dist\segmentBinder.js')" />
    <!--
      The DM1 media probe's two clips. Excluded from the glob above and named EXPLICITLY, with forward
      slashes, because two different consumers open them by that exact string: `MediaRangeProbe` via
      `OpenAppPackageFileAsync`, and the page directly, as `media/<clip>` relative to its own origin —
      which is MAUI's OWN static serving and therefore the control that proves the file, the codec and
      the emulator's media stack independently of our handler. The glob's computed LogicalName cannot
      be relied on for that: it interpolates `%(RecursiveDir)`, which is backslash-separated on Windows.

      They are a CONTROL PAIR of the same 60 s / 480x270 H.264+AAC content, differing only in where
      the `moov` atom sits — front vs end. The tail one cannot start playing until the handler has
      answered a range request for the end of the file, so it is what distinguishes real range support
      from a whole-file 200. ~464 KB each, generated with ffmpeg's `testsrc`, whose big seconds counter
      is what makes a seek provable from a screenshot.
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-faststart.mp4"
               LogicalName="wwwroot/media/clip-faststart.mp4" />
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-tailmoov.mp4"
               LogicalName="wwwroot/media/clip-tailmoov.mp4" />
    <!--
      The TRANSCODE fixture: the same 20 s of audio as MP3 inside Matroska. The codec pairing is the whole
      point — MP4 cannot CARRY mp3 as the kit's muxer defines carriable, so the remuxer is forced down the
      decode → encode → mux path instead of copying the stream, which is the path no device had ever run.
      AC-3 would be the real-world case and cannot be used: AOSP ships no AC-3 decoder, so an emulator
      could never execute it. MP3 exercises the identical chain on every target.
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-mp3.mkv"
               LogicalName="wwwroot/media/clip-mp3.mkv" />
    <!--
      The AC-3 half of the same fixture pair. Two are needed because the shells implement different input
      sets: Android's converter takes mp3 and cannot take AC-3 on AOSP (no decoder exists there), iOS takes
      AC-3 and does not claim mp3. `TranscodeProbe` uses whichever the shell CLAIMS.
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-ac3.mkv"
               LogicalName="wwwroot/media/clip-ac3.mkv" />
    <!--
      🔴 THE SAME PAIR WITH A VIDEO TRACK, and that difference is why they exist. The two fixtures above
      were built with ffmpeg's `-vn` for `TranscodeProbe`, which only cares about a soundtrack — so they are
      AUDIO-ONLY, and `ConversionRouteProbe` used them for a fortnight while never once carrying a video
      track through a conversion. The route's job on a real film is to COPY h264 and CONVERT the audio; with
      an audio-only source that half was untested, and the output legitimately had no picture.
      These carry h264 beside an audio codec MP4 cannot hold, so the probe can play the output and demand
      `videoWidth != 0` — the assertion that catches a remux which quietly dropped the video.
        ffmpeg -i clip-faststart.mp4 -t 6 -c:v copy -c:a libmp3lame -b:a 128k -f matroska clip-video-mp3.mkv
        ffmpeg -i clip-faststart.mp4 -t 6 -c:v copy -c:a ac3 -b:a 192k -ac 2 -f matroska clip-video-ac3.mkv
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-video-mp3.mkv"
               LogicalName="wwwroot/media/clip-video-mp3.mkv" />
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-video-ac3.mkv"
               LogicalName="wwwroot/media/clip-video-ac3.mkv" />
    <!--
      🔴 THE REFUSAL FIXTURE: mpeg4 video + AAC audio. AAC is carriable by MP4 on every platform, so the
      ONLY stream the kit cannot carry is the VIDEO — which makes the verdict unambiguous instead of
      blameable on the soundtrack. `ConversionRouteProbe.CheckRefusalAsync` requires the route to FAIL and
      to name `mpeg4`, because a remux will otherwise produce a perfectly good audio-only file.
      It is also a real case rather than a contrivance: this device decodes mpeg4 and its webview will not.
        ffmpeg -i clip-faststart.mp4 -t 6 -c:v mpeg4 -q:v 5 -c:a copy -f matroska clip-mpeg4-aac.mkv
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-mpeg4-aac.mkv"
               LogicalName="wwwroot/media/clip-mpeg4-aac.mkv" />
    <!--
      🔴 THE PICTURE-CONVERSION FIXTURE FOR iOS, and it exists because the mpeg4 one CANNOT serve there.
      Measured 2026-08-13 on an iPhone 17 Pro / iOS 26.6: that device has no MPEG-4 Part 2 decoder — 47
      bytes of ESDS present and VTDecompressionSession still refuses — so the arm could only ever SKIP, and
      a probe that can never pass teaches its reader to ignore a FAIL. `h263` is the one picture codec the
      same device DOES decode (`convert video h263: accepted=True`), so this is what proves iOS's
      decode -> re-encode -> mux path end to end rather than only that the seam answers.
      ⚠ `-s 352x288` is NOT optional: h263 only accepts a QCIF-family frame size and ffmpeg refuses others.
        ffmpeg -i clip-faststart.mp4 -t 6 -c:v h263 -q:v 5 -s 352x288 -c:a copy -f matroska clip-h263-aac.mkv
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-h263-aac.mkv"
               LogicalName="wwwroot/media/clip-h263-aac.mkv" />

    <!--
      🔴 THE REFUSAL FIXTURE proper, since 2026-08-12: mpeg2video + AAC. The mpeg4 file above STOPPED being
      one the day AndroidMediaVideoConversion learned to convert it — the probe then asserted a refusal that
      correctly no longer happens. A refusal fixture has to be a codec the device can neither CARRY nor
      CONVERT, and AOSP ships no mpeg2 decoder.
        ffmpeg -i clip-faststart.mp4 -t 6 -c:v mpeg2video -q:v 5 -c:a copy -f matroska clip-mpeg2-aac.mkv
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-mpeg2-aac.mkv"
               LogicalName="wwwroot/media/clip-mpeg2-aac.mkv" />
    <!--
      🔴 THE COMPUTED-REMUX FIXTURE, and it exists because NONE of the six clips above can be PLANNED.
      `Mp4Remuxer.Plan` is lossless by contract — every stream the source offers must be carriable by MP4
      as it stands, which is H.264/HEVC video and AAC audio — and every fixture above was built for the
      CONVERSION tier, so each deliberately carries something MP4 cannot hold (mp3, AC-3, mpeg4,
      mpeg2video). Measured 2026-08-12 against `Mp4Remuxer.Plan` directly: all six answer `null` and fall
      through, which is the computed route working exactly as designed and proves nothing about it.
      This one is the CONTAINER-REPAIR case the route exists for — the same 60 s H.264+AAC content as
      `clip-faststart.mp4`, copied into Matroska, so a copy is all a correct output needs.
        ffmpeg -i clip-faststart.mp4 -c copy -f matroska clip-h264-aac.mkv
      ⚠ 468 KB, planning to 488,377 bytes. It was chosen to sit under the route's then 64 MiB buffered-body
      ceiling so it would exercise the SERVE path rather than the decline; that ceiling was DELETED on
      2026-08-13 (there is no size limit now), so any plannable clip would do — and a BIG one is what the route
      has never been given on a device. ⚠ It also predates the route's `503` — the first request for a source is
      answered while a mission walks it — and the probe rides that out: `RemuxRouteProbe.WaitForPlanAsync`
      (25 attempts, one second apart, the interval the route's `Retry-After: 1` sets) is what both `CheckAsync`
      and `CheckFirstRequestAsync` drive before they judge anything.
    -->
    <MauiAsset Include="Resources\Raw\wwwroot\media\clip-h264-aac.mkv"
               LogicalName="wwwroot/media/clip-h264-aac.mkv" />
  </ItemGroup>

  <!--
    THE LIVE ACTIVITY OPT-IN — one property, and NO SWIFT AT ALL (D69). The kit compiles its own generic
    widget into a widget extension, embeds it in the app bundle and re-signs it; what the widget DRAWS
    comes from `LiveActivityAppearance`, described in C# where the rest of this app is.

    The app writes no view bodies, no lifecycle Swift, no Info.plist and no .xcodeproj.

    ⚠ An app that wants its own design system points `ShenoraLiveActivityViews` at its own SwiftUI file
    instead, and the kit's default is not compiled. `Platforms/iOS/IslandViews.swift` is still in this
    sample as the worked example of that path — swap the two lines below to run it:

      <ShenoraLiveActivityViews>Platforms/iOS/IslandViews.swift</ShenoraLiveActivityViews>
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('ios'))">
    <ShenoraLiveActivity>true</ShenoraLiveActivity>
  </PropertyGroup>

  <!--
    ⚠ A PROJECT reference does NOT import a package's buildTransitive targets, so the sample has to import
    them by hand. A real consumer with a <PackageReference Include="Shenora.iOS" /> gets this automatically
    and writes only the property above.
    That difference is exactly the packaging a project reference hides — the lesson `ADOPTION.md` records as
    "spike against the published artifact" — so the automatic path is verified separately by a pack test
    rather than assumed to work because this one does.
  -->
  <Import Project="..\..\src\Shenora.iOS\buildTransitive\Shenora.iOS.targets"
          Condition="$(TargetFramework.Contains('ios'))" />

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell for whichever platform this host is building. Conditioned exactly like the TFM
         above, and for the same reason: Shenora.iOS cannot be built on Windows at all, so an
         unconditional reference would break the Windows gate. -->
    <ProjectReference Include="..\..\src\Shenora.Android\Shenora.Android.csproj"
                      Condition="$(TargetFramework.Contains('android'))" />
    <ProjectReference Include="..\..\src\Shenora.iOS\Shenora.iOS.csproj"
                      Condition="$(TargetFramework.Contains('ios'))" />
    <!--
      No media PLATFORM reference any more (D45). Serving local files is the SHELL's interceptor plus
      Shenora's file middleware, and the range-delivery rule those two packages existed to carry turned
      out to be a property of the interception rather than of media. `Shenora.Modules.Media` arrives transitively
      through Sample.Logic, which is the point: app logic names it, the platform head does not.
    -->
    <!-- The SAME portable logic the desktop sample hosts. That shared reference is the point of the
         whole exercise: D20's portability stops being a claim about a net10.0 project and becomes two
         shells running one facade. -->
    <ProjectReference Include="..\Shenora.Sample.Logic\Shenora.Sample.Logic.csproj" />
  </ItemGroup>

</Project>

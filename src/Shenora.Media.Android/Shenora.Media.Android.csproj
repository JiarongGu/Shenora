<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android face of mobile media. Everything shared with iOS lives in `src/Shenora.Media.Mobile/`;
    this project holds the TFM, the platform floor, the package identity, and the ONE symbol that decides
    the body rule.
  -->
  <Import Project="..\Shenora.Media.Mobile\Shenora.Media.Mobile.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <!--
      No generated `Resource` designer class — the SDK emits `public partial class Resource` even for a
      library with no resources, which is accidental PUBLIC API nobody designed and which has no iOS
      counterpart. The shell packages found this by rendering the real iOS assembly against the Android
      baseline. Turning it off keeps the two mobile media surfaces genuinely identical, which is what lets
      one baseline gate both from a Windows host. Re-enable the moment this project gains a Resources/ folder.
    -->
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>

    <!--
      ⚠ THE ONE LINE THAT DIFFERS FROM THE iOS PACKAGE, and it is a measured platform fact rather than a
      preference: Android's webview applies the `Range` START to whatever body it is handed and then ignores
      the range end, so the handler must NOT slice (D44). Slicing here applies the offset twice — asking
      bytes=4-11 returns four bytes of file bytes 8-11 — and a player asking for a file's tail gets an empty
      body and retries the identical range forever. Verified on an emulator, in both directions.
    -->
    <DefineConstants>$(DefineConstants);SHENORA_MEDIA_UNSLICED</DefineConstants>

    <!-- Inline on purpose — the baseline coverage gate text-matches it here. See the shared props. -->
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.Media.Android</PackageId>
    <Description>Shenora media for Android: serves seekable media to a MAUI HybridWebView through Shenora.Media's range server, and supplies the body rule Android's webview requires (the platform applies the Range start itself, so the handler must not slice). Takes NO media engine dependency. Shares its source with Shenora.Media.iOS.</Description>
  </PropertyGroup>

</Project>

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  // No `.d.ts`: this package is a BINARY, not a library. Nothing imports it, so declarations would be
  // shipped weight with no consumer — `generic-library.md`'s "every public type earns its keep" applied
  // to a package's output rather than to its types.
  // The tests, and the fake build machine only they use: nothing the binary runs.
  "exclude": ["src/**/*.test.ts", "src/remote/fake-target.ts"]
}

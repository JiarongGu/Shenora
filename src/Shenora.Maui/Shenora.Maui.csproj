<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The TFM follows the HOST, because each one can only be built where its toolchain lives: Windows
    has the maui-android workload, and net10.0-ios needs the ios workload AND Xcode, so it can only
    build on a Mac (`dev.mjs mac`). Listing both everywhere would turn `dev.mjs verify` red on the
    machine that cannot build one of them — the same objection this repo raises against any ungated
    artifact, pointed the other way.

    Consequence worth knowing before a release: `dotnet pack` on Windows produces an ANDROID-ONLY
    package. Shipping both faces needs a macOS pack job; until there is one, the iOS TFM is proven
    but not published.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">21.0</SupportedOSPlatformVersion>
    <!-- 15.0 is what the .NET 10 iOS workload supports as its floor; MAUI's own template uses the same. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.Maui</PackageId>
    <Description>Shenora MAUI shell: the HybridWebView IPC transport (the same envelope the desktop shell speaks, over SendRawMessage/RawMessageReceived), a MAUI UI-thread dispatcher, and the MAUI implementations of the Shenora.Core shell contracts. The platform owns the loop, so the app drives ShenoraApplication.Start/Stop from its own lifecycle rather than calling Run.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Core\Shenora.Core.csproj" />
    <ProjectReference Include="..\Shenora.Ipc\Shenora.Ipc.csproj" />
  </ItemGroup>

</Project>

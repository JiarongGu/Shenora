<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The TFM follows the HOST, because each one can only be built where its toolchain lives: Windows
    has the maui-android workload, and net10.0-ios needs the ios workload AND Xcode, so it can only
    build on a Mac (`dev.mjs mac`). Listing both everywhere would turn `dev.mjs verify` red on the
    machine that cannot build one of them — the same objection this repo raises against any ungated
    artifact, pointed the other way.

    Consequence worth knowing before a release: `dotnet pack` on Windows produces an ANDROID-ONLY
    package. Shipping both faces needs ONE host carrying BOTH workloads, which is what the override
    below is for — a macOS CI runner has both available:

        dotnet pack -p:ShenoraMobileTargets=net10.0-android%3Bnet10.0-ios

    `%3B`, not a literal `;` — a semicolon on a command line is eaten by the shell before MSBuild
    sees it, and the symptom is MSBuild reporting the SECOND TFM as an unknown switch
    ("MSB1006: Property is not valid. Switch: net10.0-ios") rather than anything about quoting.
    Verified both ways over ssh.

    Measured, so the shape of the artifact is not a guess: an iOS pack on a Mac produces
    `lib/net10.0-ios26.0/` with the XML docs alongside. Note the PLATFORM VERSION in that folder name
    — it comes from the workload's TargetPlatformVersion, not from SupportedOSPlatformVersion (15.0),
    and it is what a consuming project has to be compatible with.
  -->
  <PropertyGroup Condition="'$(ShenoraMobileTargets)' == ''">
    <ShenoraMobileTargets>net10.0-android</ShenoraMobileTargets>
    <ShenoraMobileTargets Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</ShenoraMobileTargets>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>$(ShenoraMobileTargets)</TargetFrameworks>
    <!--
      Clearing the SINGULAR is mandatory, not tidiness. `src/Directory.Build.props` defaults
      TargetFramework to net10.0 for the portable packages, and when BOTH are set MSBuild honours the
      singular and ignores TargetFrameworks entirely — so the build asked for a bare net10.0 and died
      on `Assets file doesn't have a target for 'net10.0'`, which names the assets file rather than
      the property that caused it. This project read singular until it needed to multi-target.
    -->
    <TargetFramework></TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">21.0</SupportedOSPlatformVersion>
    <!-- 15.0 is what the .NET 10 iOS workload supports as its floor; MAUI's own template uses the same. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.Maui</PackageId>
    <Description>Shenora MAUI shell: the HybridWebView IPC transport (the same envelope the desktop shell speaks, over SendRawMessage/RawMessageReceived), a MAUI UI-thread dispatcher, and the MAUI implementations of the Shenora.Core shell contracts. The platform owns the loop, so the app drives ShenoraApplication.Start/Stop from its own lifecycle rather than calling Run.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Core\Shenora.Core.csproj" />
    <ProjectReference Include="..\Shenora.Ipc\Shenora.Ipc.csproj" />
  </ItemGroup>

</Project>

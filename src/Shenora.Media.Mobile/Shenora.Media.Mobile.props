<!--
  Everything the two MOBILE MEDIA packages share, so `Shenora.Media.Android.csproj` and
  `Shenora.Media.iOS.csproj` hold only what genuinely differs: their TFM, their platform floor, their
  package identity, and the ONE symbol that picks the body rule.

  This folder is SOURCE, not a project — the same arrangement `src/Shenora.Mobile/` already proves, and for
  the same reason: a shared assembly would either publish a package nobody asks for or need embedding
  tricks to hide it. There is no `Shenora.Media.Mobile` on nuget.org and there should not be.
-->
<Project>

  <PropertyGroup>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Shenora.Media</RootNamespace>
    <!--
      IsPackable is deliberately NOT here — it stays inline in each csproj. The API-baseline coverage gate
      text-matches `<IsPackable>true</IsPackable>` in the csproj, so hoisting it would make both packages
      invisible to the gate: they would ship with no baseline and nothing would say so. The shell packages
      documented this trap first; the one duplicated line is the cheaper mistake.
    -->
    <!--
      The plural is required even for ONE target framework: src/Directory.Build.props defaults the SINGULAR
      TargetFramework to net10.0 for the portable packages, and MSBuild honours the singular whenever both
      are set — so a project here using the singular would silently build as net10.0 and die on "Assets file
      doesn't have a target for 'net10.0'", naming the assets file rather than the property responsible.
    -->
    <TargetFramework></TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shenora.Media only. NOT the shell package: this needs `IUiDispatcher`-free, control-free code — a
      resource handler and a range decision — so an edge to `Shenora.Android`/`Shenora.iOS` would be
      declared and uncrossed, which is one of the defects the review checklist hunts for by name. D40 left
      this edge "to determine when building"; built, and the answer is that it does not exist.
    -->
    <ProjectReference Include="..\Shenora.Media\Shenora.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shenora.Media.Mobile\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

<Project>

  <!--
    Single source of truth for the Shenora library version (semver major.minor.patch), applied to
    every packable project under src/ AND to the @shenora/react npm package (devtools syncs its
    package.json from here). devtools/project.config.mjs reads VersionPrefix so the tooling and
    the assemblies can never drift. `dotnet pack -p:Version=X` overrides for a release.
  -->
  <PropertyGroup>
    <VersionPrefix>0.13.0</VersionPrefix>
  </PropertyGroup>

  <!-- Shared build settings for src/*. Deliberately under src/ (not the repo root) so tests/
       samples do NOT inherit packability; they restate the few shared properties they need. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BOM-less UTF-8 sources on a CJK-locale machine mojibake without this (csc reads them as ANSI). -->
    <CodePage>65001</CodePage>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- NuGet metadata shared by the packable src/* projects (each sets its own PackageId + Description). -->
  <PropertyGroup>
    <Authors>Jiarong Gu</Authors>
    <Product>Shenora</Product>
    <PackageProjectUrl>https://github.com/JiarongGu/Shenora</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JiarongGu/Shenora</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>desktop;winforms;webview2;react;ipc;hosting;framework;windows</PackageTags>
  </PropertyGroup>

  <!-- Docs, symbols, SourceLink. SourceLink needs NO package reference on modern SDKs
       (EnableSourceLink defaults true) — only PublishRepositoryUrl. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML doc on a public member) is ON as of the P7 docs sweep — nothing is
         suppressed here any more. It is an ERROR like every other warning, which is the point: a
         public member is SemVer surface from 1.0, and "document it later" is how a shipped API ends
         up with members nobody can explain. Warnings used to be both non-fatal AND invisible
         (`-clp:ErrorsOnly`), which is part of how the P0-P5 latent defects passed five phase
         reviews (P5.5 H5).
         Adding a public member now requires documenting it. That is deliberate. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The repo README ships inside every package (PackageReadmeFile above points at it). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The single test project sees internals of every src assembly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Shenora.Tests" />
  </ItemGroup>

  <!--
    The MAUI sample is a DEVICE PROBE, not an adoption example, and it reads back what it produced to
    prove the output is right: `Mp4FragmentReader` (does this fragment declare the track, and at what
    decode time?) and `SegmentRunWriter` (what did the encoder emit vs what was read?). Both are
    implementation detail no adopter should program against, so they stay internal and the probe borrows
    them.
    ⚠ NARROWED, not removed. It was written when `DefaultSegmentEngine` was also borrowed — the engine
    is now reachable publicly through `SegmentEngine.Default(...)`, which was that instruction's whole
    point. What is left is genuinely probe-only.
    🔴 So the standing rule still applies to what remains: if the sample ever stops using those two
    types, DELETE this. A temporary grant that outlives its reason is indistinguishable from a
    deliberate one, and this file is not somewhere anyone re-reads.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Shenora.Sample.Maui" />
  </ItemGroup>

</Project>

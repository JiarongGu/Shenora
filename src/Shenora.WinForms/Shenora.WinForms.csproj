<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.WinForms</PackageId>
    <Description>Shenora WinForms shell: application bootstrapper with global exception handling, DPI-correct window-state persistence, single-instance guard with activate broadcast, secondary windows, STA file dialogs, clipboard/shell services, drag-drop overlays, tray support, and the UI-thread dispatcher.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Core\Shenora.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.WinForms</PackageId>
    <Description>Shenora WinForms shell: application bootstrapper with global exception handling, DPI-correct window-state persistence, single-instance guard with activate broadcast, secondary windows on their own STA threads, tray icon, frameless-chrome form, splash panel, STA file dialogs, and clipboard/shell services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Core\Shenora.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows shell, whole. Merged from Shenora.WinForms + Shenora.WebView2 +
    Shenora.WebView2.Sessions (owner, 2026-08-02) because the split protected a consumer that cannot
    exist: this kit's premise is React in a webview, so there is no Windows path that takes the
    WinForms primitives and not WebView2. The seam it preserved — WinForms with no IPC dependency —
    described an adoption STAGE, not a shipping configuration.

    The measurement that settled the last objection: Sessions adds NO dependency of its own (it
    already shared Microsoft.Web.WebView2), so folding it in costs ~28 KB of IL and no graph change.
    The "52.6 MB" figure raised against merging was dev-time RESTORE size, not shipped bytes — the
    WebView2 runtime is an Evergreen system component and what lands in an app's output is a small
    loader.

    Folders keep the three areas legible, which is the part of the old split worth keeping:
      Shell/      Windows primitives — bootstrap, frameless chrome, tray, secondary windows,
                  window state, STA dialogs/clipboard/shell, the UI-thread dispatcher
      WebView/    WebView2 hosting, serving, the IPC bridge, drop zones, window commands
      Sessions/   auxiliary browser sessions — render pool, interactive, streaming
  -->
  <PropertyGroup>
    <!--
      The SDK version in the TFM is what pulls in the WinRT PROJECTIONS (Microsoft.Windows.SDK.NET.Ref, the
      CsWinRT-generated `Windows.*` surface). Without any version, `Windows.Media` does not exist as a C#
      namespace at all — measured — and SystemMediaTransportControls is therefore unreachable, which is why
      IPlaybackSession forced this. 19041 is the oldest projection this machine's SDK ships (the other is
      22621) and nothing here needs a newer API.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!--
      ⚠ AND THE RUNTIME FLOOR IS SET SEPARATELY, or it silently follows the TFM. TargetPlatformVersion
      (19041, above) is what you may COMPILE against; SupportedOSPlatformVersion is the minimum you RUN on,
      and leaving it unset defaults it to the TFM version — which quietly turned "reference this package"
      into "require Windows 10 2004", a much bigger ask than the change needed. Pinning it low keeps the
      break to the TFM string alone. The WinRT types used here (MediaPlayer, SystemMediaTransportControls)
      have existed since Windows 10 1507, so nothing is being called that this floor cannot reach — and
      CA1416 is a build ERROR in this repo, so an API newer than this floor cannot slip in unguarded.
    -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.Windows</PackageId>
    <!-- The WebView2 package always references its WPF assembly, whose WindowsBase differs from a
         WinForms-only project's — MSB3277 fires but the WPF dll is never loaded here. Demote it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!--
      MECHANISM vocabulary only (D22). The Sessions half of this description used to read "login
      windows with per-provider persistent profiles" and "co-browse streaming primitives" — the exact
      scenario names P5.5 H9.7/H9.8 removed from the TYPES (LoginWindow -> InteractiveSession,
      CoBrowseSession -> StreamingSession). It survived because D22's audit method is "sweep the API
      baselines for domain words", and a csproj Description is not in any baseline — while being the
      single most public place that vocabulary appears (the nuget.org listing). Name what the types
      do, not one product they enable.
    -->
    <Description>Shenora's Windows shell: application bootstrapper with global exception handling, DPI-correct window-state persistence, single-instance guard with activate broadcast, secondary windows on their own STA threads, tray icon, frameless-chrome form, and the Windows implementations of the Shenora.Core shell contracts (STA file dialogs, clipboard, shell launching, UI-thread dispatcher). Hosts WebView2: environment prewarm, dev-server vs packaged-frontend loading, navigation/new-window/download/permission/process-failure handling, drag-drop zones, and the postMessage IPC bridge with batched event push. Includes auxiliary browser sessions — off-screen driveable sessions with a bounded pool, interactive sessions over an isolated persistent profile, and streaming sessions (CDP screencast out, synthetic input in). Mechanisms only: the kit ships no workflow.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Core\Shenora.Core.csproj" />
    <ProjectReference Include="..\Shenora.Ipc\Shenora.Ipc.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

</Project>

<Project>

  <!--
    The Chromium shell's app build (D81, D82): the engine arrives through THIS build, from CEF's own published
    builds, and never sits inside a kit package.

      ShenoraChromiumFetchCef   the pinned CEF build for the RuntimeIdentifier, downloaded ONCE per machine into
                                a shared cache, its SHA-1 checked against the pin (deleted, and the build failed,
                                on a mismatch), and extracted.
      ShenoraChromiumLayout     after Build (and Publish): CEF's runtime beside the app, CEF's bootstrap.exe as
                                <App>.exe, and the kit's shim as <App>.dll. The launcher creates Chromium's
                                sandbox and loads <App>.dll, which starts the app's own <App>.App.dll.

    So the app's assembly is named <App>.App, and the build refuses otherwise rather than lay out an app that
    cannot start. Set ShenoraChromiumLayout=false to build without the engine (a compile-only CI step).

      ShenoraChromiumMacLayout  after Build on macOS: bundle/<App>.app, whose Contents/MacOS holds the app with the .NET
                                apphost as <App>, and whose Contents/Frameworks holds CEF's framework and the five
                                helper apps CEF starts its subprocesses from, each the kit's helper.

    The Linux layout is not built yet.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Shenora.Chromium.Cef.g.targets" />

  <PropertyGroup>
    <ShenoraChromiumLayout Condition="'$(ShenoraChromiumLayout)' == ''">true</ShenoraChromiumLayout>
    <!-- On Windows CEF's bootstrap.exe IS the app's exe, so the .NET apphost would be a second, wrong one. On macOS
         the apphost is the bundle's executable. -->
    <UseAppHost Condition="'$(ShenoraChromiumLayout)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">false</UseAppHost>

    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">windows64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">windowsarm64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'osx-x64'">macosx64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">macosarm64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">linuxarm64</ShenoraCefPlatform>

    <!-- Shared by every app on the machine: the Windows x64 build is 165 MB to download and 424 MB extracted.
         Two builds can race on it (parallel projects, two solutions), so each one downloads and extracts into
         names of its own and only an atomic rename publishes dist/. -->
    <_ShenoraCefRun>$([System.Guid]::NewGuid().ToString('N'))</_ShenoraCefRun>
    <!-- Windows' own bsdtar, never whichever tar PATH finds: from Git Bash that is GNU tar, which took 112 s to
         the bsdtar's 28 s for the same fetch, measured side by side. -->
    <_ShenoraTar Condition="'$(OS)' == 'Windows_NT' and Exists('$(SystemRoot)\System32\tar.exe')">&quot;$(SystemRoot)\System32\tar.exe&quot;</_ShenoraTar>
    <_ShenoraTar Condition="'$(_ShenoraTar)' == ''">tar</_ShenoraTar>
    <ShenoraCefCache Condition="'$(ShenoraCefCache)' == '' and '$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)\Shenora\cef</ShenoraCefCache>
    <ShenoraCefCache Condition="'$(ShenoraCefCache)' == ''">$(HOME)/.cache/shenora/cef</ShenoraCefCache>
    <ShenoraCefRoot>$([System.IO.Path]::Combine('$(ShenoraCefCache)', '$(ShenoraCefBuild)', '$(ShenoraCefPlatform)'))</ShenoraCefRoot>
    <ShenoraCefDist>$([System.IO.Path]::Combine('$(ShenoraCefRoot)', 'dist'))</ShenoraCefDist>

    <!-- The package's own native half, the Windows shim or the macOS helper; in this repo, where an app references the
         project, the one cef-native staged. -->
    <_ShenoraNative Condition="$(ShenoraCefPlatform.StartsWith('macos'))">shenora_chromium_helper</_ShenoraNative>
    <_ShenoraNative Condition="'$(_ShenoraNative)' == ''">shenora_chromium_shim.dll</_ShenoraNative>
    <ShenoraChromiumShim Condition="'$(ShenoraChromiumShim)' == '' and Exists('$(MSBuildThisFileDirectory)..\tools')">$(MSBuildThisFileDirectory)..\tools\$(RuntimeIdentifier)\native\$(_ShenoraNative)</ShenoraChromiumShim>
    <ShenoraChromiumShim Condition="'$(ShenoraChromiumShim)' == ''">$(MSBuildThisFileDirectory)..\artifacts\runtimes\$(RuntimeIdentifier)\native\$(_ShenoraNative)</ShenoraChromiumShim>
  </PropertyGroup>

  <!-- GetFileHash has no SHA-1, and SHA-1 is what CEF's index publishes. -->
  <UsingTask TaskName="ShenoraCefSha1" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var stream = System.IO.File.OpenRead(File))
        using (var sha1 = System.Security.Cryptography.SHA1.Create())
            Hash = System.BitConverter.ToString(sha1.ComputeHash(stream)).Replace("-", "").ToLowerInvariant();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Publishes a finished extraction as dist/ by renaming it, which is atomic, so dist/ only ever exists
       complete. A build that loses the race deletes its own copy and uses the winner's. -->
  <UsingTask TaskName="ShenoraCefPublish" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        try { if (!System.IO.Directory.Exists(Destination)) System.IO.Directory.Move(Source, Destination); }
        catch (System.IO.IOException) when (System.IO.Directory.Exists(Destination)) { }
        if (System.IO.Directory.Exists(Source)) System.IO.Directory.Delete(Source, true);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Every refusal runs BEFORE the fetch, so a build that cannot be laid out never downloads 165 MB first. -->
  <Target Name="_ShenoraChromiumCheck">
    <Error Condition="'$(ShenoraCefPlatform)' == ''"
           Text="Shenora.Chromium needs a RuntimeIdentifier CEF publishes a build for (win-x64, win-arm64, osx-x64, osx-arm64, linux-x64, linux-arm64); this build has '$(RuntimeIdentifier)'. Set &lt;RuntimeIdentifier&gt; in the app's project." />
    <Error Condition="$(ShenoraCefPlatform.StartsWith('linux'))" Text="The Chromium shell's app layout is Windows' and macOS' today (this build targets $(RuntimeIdentifier)); the Linux layout is not built yet." />
    <Error Condition="!$(AssemblyName.EndsWith('.App'))"
           Text="A Shenora.Chromium app's own assembly must be named '&lt;App&gt;.App' (this one is '$(AssemblyName)'): CEF's launcher runs as &lt;App&gt;.exe and loads &lt;App&gt;.dll, the kit's shim, which starts &lt;App&gt;.App.dll. Set &lt;AssemblyName&gt;$(AssemblyName).App&lt;/AssemblyName&gt;." />
    <Error Condition="!Exists('$(ShenoraChromiumShim)')" Text="The kit's native half for $(RuntimeIdentifier) is missing at $(ShenoraChromiumShim). The package carries it for win-x64 and win-arm64; in this repo, `node devtools/dev.mjs cef-native --rid $(RuntimeIdentifier)` builds and stages it (a macOS RID on a Mac)." />
  </Target>

  <Target Name="ShenoraChromiumFetchCef" DependsOnTargets="_ShenoraChromiumCheck" Condition="'$(ShenoraChromiumLayout)' == 'true'">
    <ItemGroup>
      <_ShenoraCefPick Include="@(ShenoraCefDistribution)" Condition="'%(Identity)' == '$(ShenoraCefPlatform)'" />
    </ItemGroup>
    <PropertyGroup>
      <_ShenoraCefFile>@(_ShenoraCefPick->'%(File)')</_ShenoraCefFile>
      <_ShenoraCefSha1>@(_ShenoraCefPick->'%(Sha1)')</_ShenoraCefSha1>
      <_ShenoraCefPart>$(_ShenoraCefFile).$(_ShenoraCefRun).part</_ShenoraCefPart>
      <_ShenoraCefArchive>$([System.IO.Path]::Combine('$(ShenoraCefRoot)', '$(_ShenoraCefPart)'))</_ShenoraCefArchive>
      <_ShenoraCefStaging>dist.$(_ShenoraCefRun)</_ShenoraCefStaging>
      <_ShenoraCefNeeded Condition="!Exists('$(ShenoraCefDist)')">true</_ShenoraCefNeeded>
    </PropertyGroup>
    <Error Condition="'$(_ShenoraCefFile)' == ''" Text="The pinned CEF build $(ShenoraCefBuild) names no distribution for $(ShenoraCefPlatform)." />

    <MakeDir Condition="'$(_ShenoraCefNeeded)' == 'true'" Directories="$(ShenoraCefRoot)" />
    <DownloadFile Condition="'$(_ShenoraCefNeeded)' == 'true'"
                  SourceUrl="https://cef-builds.spotifycdn.com/$([System.Uri]::EscapeDataString('$(_ShenoraCefFile)'))"
                  DestinationFolder="$(ShenoraCefRoot)" DestinationFileName="$(_ShenoraCefPart)" />
    <ShenoraCefSha1 Condition="'$(_ShenoraCefNeeded)' == 'true'" File="$(_ShenoraCefArchive)">
      <Output TaskParameter="Hash" PropertyName="_ShenoraCefActual" />
    </ShenoraCefSha1>
    <Delete Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefActual)' != '$(_ShenoraCefSha1)'" Files="$(_ShenoraCefArchive)" />
    <Error Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefActual)' != '$(_ShenoraCefSha1)'"
           Text="The CEF download failed its SHA-1 check: got $(_ShenoraCefActual), the pin says $(_ShenoraCefSha1). The file was deleted; the next build downloads it again." />

    <!-- Relative paths from inside the cache, so a GNU tar (a POSIX host) never reads `D:\…` as a remote host. -->
    <MakeDir Condition="'$(_ShenoraCefNeeded)' == 'true'" Directories="$(ShenoraCefRoot)\$(_ShenoraCefStaging)" />
    <Exec Condition="'$(_ShenoraCefNeeded)' == 'true'" ContinueOnError="true" WorkingDirectory="$(ShenoraCefRoot)"
          Command="$(_ShenoraTar) -xjf &quot;$(_ShenoraCefPart)&quot; --strip-components=1 -C $(_ShenoraCefStaging)">
      <Output TaskParameter="ExitCode" PropertyName="_ShenoraCefTar" />
    </Exec>
    <Delete Condition="'$(_ShenoraCefNeeded)' == 'true'" Files="$(_ShenoraCefArchive)" />
    <RemoveDir Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefTar)' != '0'" Directories="$(ShenoraCefRoot)\$(_ShenoraCefStaging)" />
    <Error Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefTar)' != '0'" Text="Extracting the CEF build failed (tar exited $(_ShenoraCefTar)); nothing was kept, so the next build starts again." />
    <ShenoraCefPublish Condition="'$(_ShenoraCefNeeded)' == 'true'" Source="$(ShenoraCefRoot)\$(_ShenoraCefStaging)" Destination="$(ShenoraCefDist)" />
  </Target>

  <Target Name="_ShenoraChromiumLayoutInputs" DependsOnTargets="ShenoraChromiumFetchCef">
    <PropertyGroup>
      <_ShenoraAppExe>$(AssemblyName.Substring(0, $([MSBuild]::Subtract($(AssemblyName.Length), 4))))</_ShenoraAppExe>
      <!-- A GUI app gets the GUI launcher, a console app the console one; the shim answers both. -->
      <_ShenoraBootstrap Condition="'$(OutputType)' == 'WinExe'">bootstrap.exe</_ShenoraBootstrap>
      <_ShenoraBootstrap Condition="'$(OutputType)' != 'WinExe'">bootstrapc.exe</_ShenoraBootstrap>
    </PropertyGroup>
    <ItemGroup>
      <_ShenoraCefRuntime Include="$(ShenoraCefDist)\Release\*.dll;$(ShenoraCefDist)\Release\*.bin;$(ShenoraCefDist)\Release\*.json" />
      <_ShenoraCefResources Include="$(ShenoraCefDist)\Resources\**\*" />
    </ItemGroup>
  </Target>

  <Target Name="ShenoraChromiumLayout" AfterTargets="Build" DependsOnTargets="_ShenoraChromiumLayoutInputs" Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('windows'))">
    <Copy SourceFiles="@(_ShenoraCefRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShenoraCefResources)" DestinationFolder="$(OutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraCefDist)\Release\$(_ShenoraBootstrap)" DestinationFiles="$(OutDir)$(_ShenoraAppExe).exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraChromiumShim)" DestinationFiles="$(OutDir)$(_ShenoraAppExe).dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ShenoraChromiumPublishLayout" AfterTargets="Publish" DependsOnTargets="_ShenoraChromiumLayoutInputs" Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('windows'))">
    <Copy SourceFiles="@(_ShenoraCefRuntime)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShenoraCefResources)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraCefDist)\Release\$(_ShenoraBootstrap)" DestinationFiles="$(PublishDir)$(_ShenoraAppExe).exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraChromiumShim)" DestinationFiles="$(PublishDir)$(_ShenoraAppExe).dll" SkipUnchangedFiles="true" />
  </Target>

  <!-- An Info.plist, the one piece of a bundle the build has to write rather than copy. -->
  <UsingTask TaskName="ShenoraMacPlist" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Executable ParameterType="System.String" Required="true" />
      <Identifier ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <Helper ParameterType="System.Boolean" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string E(string s) => System.Security.SecurityElement.Escape(s);
        var plist = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
          + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
          + "<plist version=\"1.0\">\n<dict>\n"
          + "  <key>CFBundleExecutable</key><string>" + E(Executable) + "</string>\n"
          + "  <key>CFBundleIdentifier</key><string>" + E(Identifier) + "</string>\n"
          + "  <key>CFBundleName</key><string>" + E(Executable) + "</string>\n"
          + "  <key>CFBundlePackageType</key><string>APPL</string>\n"
          + "  <key>CFBundleShortVersionString</key><string>" + E(Version) + "</string>\n"
          + "  <key>CFBundleVersion</key><string>" + E(Version) + "</string>\n"
          + "  <key>LSMinimumSystemVersion</key><string>12.0</string>\n"
          + "  <key>NSHighResolutionCapable</key><true/>\n"
          + (Helper ? "  <key>LSUIElement</key><true/>\n" : "  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>\n")
          + "</dict>\n</plist>\n";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(File));
        System.IO.File.WriteAllText(File, plist);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- macOS: <App>.app. CEF finds its framework and helpers by the bundle's shape, so the shape is the contract. -->
  <Target Name="ShenoraChromiumMacLayout" AfterTargets="Build" DependsOnTargets="ShenoraChromiumFetchCef"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('macos'))">
    <PropertyGroup>
      <_ShenoraAppExe>$(AssemblyName.Substring(0, $([MSBuild]::Subtract($(AssemblyName.Length), 4))))</_ShenoraAppExe>
      <!-- In a folder of its own: macOS's file system ignores case, so <App>.app beside the <App>.App apphost is the
           same name (measured: the bundle's folders could not be created). -->
      <_ShenoraBundleDir>$(OutDir)bundle/</_ShenoraBundleDir>
      <_ShenoraBundle>$(_ShenoraBundleDir)$(_ShenoraAppExe).app</_ShenoraBundle>
      <_ShenoraContents>$(_ShenoraBundle)/Contents</_ShenoraContents>
      <!-- Letters, digits, dots and hyphens only, which is all a bundle identifier may hold. -->
      <ShenoraChromiumBundleId Condition="'$(ShenoraChromiumBundleId)' == ''">com.shenora.app.$([System.Text.RegularExpressions.Regex]::Replace('$(_ShenoraAppExe)', '[^A-Za-z0-9.-]', '-'))</ShenoraChromiumBundleId>
      <_ShenoraBundleVersion>$(Version)</_ShenoraBundleVersion>
      <_ShenoraBundleVersion Condition="'$(_ShenoraBundleVersion)' == ''">1.0.0</_ShenoraBundleVersion>
    </PropertyGroup>
    <ItemGroup>
      <!-- The app's build output, except the bundle this target makes inside it. -->
      <_ShenoraAppFiles Include="$(OutDir)**/*" Exclude="$(_ShenoraBundleDir)**" />
      <_ShenoraCefFramework Include="$(ShenoraCefDist)/Release/Chromium Embedded Framework.framework/**/*" />
      <!-- The five helpers Chromium starts its subprocess types from, all the same binary. -->
      <_ShenoraHelper Include="helper" Variant="" />
      <_ShenoraHelper Include="helper.gpu" Variant=" (GPU)" />
      <_ShenoraHelper Include="helper.renderer" Variant=" (Renderer)" />
      <_ShenoraHelper Include="helper.plugin" Variant=" (Plugin)" />
      <_ShenoraHelper Include="helper.alerts" Variant=" (Alerts)" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShenoraAppFiles)" DestinationFolder="$(_ShenoraContents)/MacOS/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName)" DestinationFiles="$(_ShenoraContents)/MacOS/$(_ShenoraAppExe)" SkipUnchangedFiles="true" />
    <ShenoraMacPlist File="$(_ShenoraContents)/Info.plist" Executable="$(_ShenoraAppExe)" Identifier="$(ShenoraChromiumBundleId)" Version="$(_ShenoraBundleVersion)" />
    <Copy SourceFiles="@(_ShenoraCefFramework)" DestinationFolder="$(_ShenoraContents)/Frameworks/Chromium Embedded Framework.framework/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraChromiumShim)" DestinationFiles="$(_ShenoraContents)/Frameworks/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant).app/Contents/MacOS/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant)" SkipUnchangedFiles="true" />
    <ShenoraMacPlist File="$(_ShenoraContents)/Frameworks/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant).app/Contents/Info.plist"
                     Executable="$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant)" Identifier="$(ShenoraChromiumBundleId).%(_ShenoraHelper.Identity)"
                     Version="$(_ShenoraBundleVersion)" Helper="true" />
  </Target>

</Project>

<Project>

  <!--
    The Chromium shell's app build (D81, D82): the engine arrives through THIS build, from CEF's own published
    builds, and never sits inside a kit package.

      ShenoraChromiumFetchCef   the pinned CEF build for the RuntimeIdentifier, downloaded ONCE per machine into
                                a shared cache, its SHA-1 checked against the pin (deleted, and the build failed,
                                on a mismatch), and extracted.
      ShenoraChromiumLayout     after Build (and Publish): CEF's runtime beside the app, CEF's bootstrap.exe as
                                <App>.exe, and the kit's shim as <App>.dll. The launcher creates Chromium's
                                sandbox and loads <App>.dll, which starts the app's own <App>.App.dll.

    An engine of the app's own, such as the kit's Shenora.Chromium.Codecs.win-x64 package (CEF with H.264, AAC and HEVC,
    D99), comes with the package reference: its build\ props set ShenoraChromiumEnginePath, and the layout is laid out
    from it with no fetch. CEF's standard engine, which is the default, decodes none of those codecs.

    So the app's assembly is named <App>.App, and the build refuses otherwise rather than lay out an app that
    cannot start. Set ShenoraChromiumLayout=false to build without the engine (a compile-only CI step), and
    ShenoraChromiumLocales (such as "zh-CN;fr") to lay out only those of CEF's locales, and en-US. The app's own
    icon: ApplicationIcon (.ico) on Windows, ShenoraChromiumBundleIcon (.icns) for the macOS bundle.
    ShenoraChromiumRelaxContextIp=false (Windows) keeps CEF's strict context-IP validation in the launcher: by default the
    layout relaxes it (shadow stack stays on), so a shell extension's handled exception does not end the app.
    ShenoraChromiumPublishFolders=true (Windows and Linux, publish only; off by default) publishes MyApp.exe, MyApp.dll and
    chrome_elf.dll at the root (on Linux the one executable, MyApp), CEF in engine\ and everything the SDK publishes in lib\,
    instead of all side by side.

      ShenoraChromiumMacLayout  after Build (and Publish) on macOS: bundle/<App>.app beside the output, whose
                                Contents/MacOS holds the app with the .NET apphost as <App>, and whose
                                Contents/Frameworks holds CEF's framework and the five helper apps CEF starts its
                                subprocesses from, each the kit's helper. A self-contained publish carries the
                                runtime inside it, so the app starts from Finder with no .NET installed.

      ShenoraChromiumLinuxLayout after Build (and Publish) on Linux: CEF's runtime and resources beside the app, the
                                .NET apphost also as <App>, and the kit's helper as <App>-helper, which every CEF
                                subprocess runs. With ShenoraChromiumPublishFolders a publish puts <App> alone at the
                                root (its apphost pointed at lib/), CEF's runtime and the helper in engine/, and the
                                app in lib/.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Shenora.Chromium.Cef.g.targets" />

  <PropertyGroup>
    <ShenoraChromiumLayout Condition="'$(ShenoraChromiumLayout)' == ''">true</ShenoraChromiumLayout>
    <!-- On Windows CEF's bootstrap.exe IS the app's exe, so the .NET apphost would be a second, wrong one. On macOS
         the apphost is the bundle's executable. A self-contained app keeps it: the SDK refuses one without (NETSDK1067),
         and what it publishes is the runtime beside the app, which is all that publish takes from it. -->
    <UseAppHost Condition="'$(ShenoraChromiumLayout)' == 'true' and $(RuntimeIdentifier.StartsWith('win')) and '$(SelfContained)' != 'true'">false</UseAppHost>

    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">windows64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">windowsarm64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'osx-x64'">macosx64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">macosarm64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux64</ShenoraCefPlatform>
    <ShenoraCefPlatform Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">linuxarm64</ShenoraCefPlatform>

    <!-- Shared by every app on the machine: the Windows x64 build is 165 MB to download and 424 MB extracted.
         Two builds can race on it (parallel projects, two solutions), so each one downloads and extracts into
         names of its own and only an atomic rename publishes dist/. -->
    <_ShenoraCefRun>$([System.Guid]::NewGuid().ToString('N'))</_ShenoraCefRun>
    <!-- Windows' own bsdtar, never whichever tar PATH finds: from Git Bash that is GNU tar, which took 112 s to
         the bsdtar's 28 s for the same fetch, measured side by side. -->
    <_ShenoraTar Condition="'$(OS)' == 'Windows_NT' and Exists('$(SystemRoot)\System32\tar.exe')">&quot;$(SystemRoot)\System32\tar.exe&quot;</_ShenoraTar>
    <_ShenoraTar Condition="'$(_ShenoraTar)' == ''">tar</_ShenoraTar>
    <ShenoraCefCache Condition="'$(ShenoraCefCache)' == '' and '$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)\Shenora\cef</ShenoraCefCache>
    <ShenoraCefCache Condition="'$(ShenoraCefCache)' == ''">$(HOME)/.cache/shenora/cef</ShenoraCefCache>
    <ShenoraChromiumStrip Condition="'$(ShenoraChromiumStrip)' == ''">strip --strip-all</ShenoraChromiumStrip>
    <ShenoraCefRoot>$([System.IO.Path]::Combine('$(ShenoraCefCache)', '$(ShenoraCefBuild)', '$(ShenoraCefPlatform)'))</ShenoraCefRoot>
    <ShenoraCefDist>$([System.IO.Path]::Combine('$(ShenoraCefRoot)', 'dist'))</ShenoraCefDist>
    <!-- ShenoraChromiumEnginePath: an engine build the app brings with it, CEF's Release\ and Resources\ folders, used in
         place of the fetch. A package such as Shenora.Chromium.Codecs.win-x64 (D99) sets it, and
         ShenoraChromiumEnginePlatform (CEF's platform name for it), from its own build\ props, which NuGet imports ahead of
         this file. -->
    <ShenoraCefDist Condition="'$(ShenoraChromiumEnginePath)' != ''">$([System.IO.Path]::GetFullPath('$(ShenoraChromiumEnginePath)'))</ShenoraCefDist>

    <!-- The package's own native half, the Windows shim or the macOS helper; in this repo, where an app references the
         project, the one cef-native staged. -->
    <_ShenoraNative Condition="$(ShenoraCefPlatform.StartsWith('macos')) or $(ShenoraCefPlatform.StartsWith('linux'))">shenora_chromium_helper</_ShenoraNative>
    <_ShenoraNative Condition="'$(_ShenoraNative)' == ''">shenora_chromium_shim.dll</_ShenoraNative>
    <ShenoraChromiumShim Condition="'$(ShenoraChromiumShim)' == '' and Exists('$(MSBuildThisFileDirectory)..\tools')">$(MSBuildThisFileDirectory)..\tools\$(RuntimeIdentifier)\native\$(_ShenoraNative)</ShenoraChromiumShim>
    <ShenoraChromiumShim Condition="'$(ShenoraChromiumShim)' == ''">$(MSBuildThisFileDirectory)..\artifacts\runtimes\$(RuntimeIdentifier)\native\$(_ShenoraNative)</ShenoraChromiumShim>
  </PropertyGroup>

  <!-- GetFileHash has no SHA-1, and SHA-1 is what CEF's index publishes. -->
  <UsingTask TaskName="ShenoraCefSha1" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var stream = System.IO.File.OpenRead(File))
        using (var sha1 = System.Security.Cryptography.SHA1.Create())
            Hash = System.BitConverter.ToString(sha1.ComputeHash(stream)).Replace("-", "").ToLowerInvariant();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Publishes a finished extraction as dist/ by renaming it, which is atomic, so dist/ only ever exists
       complete. A build that loses the race deletes its own copy and uses the winner's. -->
  <UsingTask TaskName="ShenoraCefPublish" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Whatever scans a just-extracted tree of 400 MB can hold it for a moment, and the rename then fails with "access to
        // the path is denied" (measured once, and gone on the next try); the SDK retries its own apphost for the same reason.
        for (var attempt = 1; ; attempt++)
        {
            try { if (!System.IO.Directory.Exists(Destination)) System.IO.Directory.Move(Source, Destination); break; }
            catch (System.IO.IOException) when (System.IO.Directory.Exists(Destination)) { break; }
            catch (System.Exception e) when (attempt < 6 && (e is System.IO.IOException || e is System.UnauthorizedAccessException))
            {
                System.Threading.Thread.Sleep(500 * attempt);
            }
        }
        if (System.IO.Directory.Exists(Source)) System.IO.Directory.Delete(Source, true);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- ShenoraChromiumLocales ("zh-CN;fr"): the locales to lay out, where CEF carries 220 (49 MB). Each keeps its
       gendered variants, and en-US, Chromium's fallback, always stays. Windows names a locale's file <name>.pak;
       macOS names its folder <name>.lproj with '_' for '-', and en-US plain "en". It returns the locale files to DROP,
       which the caller removes from its own items so the rest keep their metadata (RecursiveDir places them), and any
       name the build has no locale for, so the build can warn. -->
  <UsingTask TaskName="ShenoraChromiumLocaleFilter" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Locales ParameterType="System.String" Required="true" />
      <Dropped ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <Missing ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var keep = new System.Collections.Generic.HashSet<string>(System.StringComparer.OrdinalIgnoreCase) { "en-US" };
        foreach (var name in Locales.Split(new[] { ';', ',' }, System.StringSplitOptions.RemoveEmptyEntries)) keep.Add(name.Trim());
        var found = new System.Collections.Generic.HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
        var dropped = new System.Collections.Generic.List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var file in Files)
        {
            var path = file.ItemSpec.Replace('\\', '/');
            string locale = null;
            var lproj = path.IndexOf(".lproj/", System.StringComparison.OrdinalIgnoreCase);
            if (lproj > 0)
            {
                var folder = path.Substring(0, lproj);
                locale = folder.Substring(folder.LastIndexOf('/') + 1);
            }
            else if (path.IndexOf("/locales/", System.StringComparison.OrdinalIgnoreCase) >= 0 && path.EndsWith(".pak", System.StringComparison.OrdinalIgnoreCase))
            {
                locale = System.IO.Path.GetFileNameWithoutExtension(path);
            }
            if (locale == null) continue;
            foreach (var gender in new[] { "_FEMININE", "_MASCULINE", "_NEUTER" })
                if (locale.EndsWith(gender, System.StringComparison.OrdinalIgnoreCase)) { locale = locale.Substring(0, locale.Length - gender.Length); break; }
            locale = locale.Replace('_', '-');
            if (string.Equals(locale, "en", System.StringComparison.OrdinalIgnoreCase)) locale = "en-US";
            found.Add(locale);
            if (!keep.Contains(locale)) dropped.Add(file);
        }
        Dropped = dropped.ToArray();
        var missing = new System.Collections.Generic.List<string>();
        foreach (var name in keep) if (!found.Contains(name)) missing.Add(name);
        Missing = string.Join(", ", missing);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Windows: <App>.exe is CEF's bootstrap copied in, and presents as CEF ("CEF Bootstrap Application", CEF's icon and
       version) wherever Windows names a program: Task Manager, Explorer, a pinned taskbar button. So its icon and version
       resources are replaced by the app's own, copied from <App>.App.dll, which the compiler built from ApplicationIcon,
       Product, Company and the version: what the .NET SDK does for its own apphost. Its manifest is left alone; CEF's
       processes need its supportedOS entry. An app with no ApplicationIcon gets no icon rather than CEF's. -->
  <UsingTask TaskName="ShenoraChromiumStampLauncher" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String" Required="true" />
      <From ParameterType="System.String" Required="true" />
      <StartupScreen ParameterType="System.String" />
      <StartupScreenWidth ParameterType="System.String" />
      <StartupScreenHeight ParameterType="System.String" />
      <StartupScreenBackground ParameterType="System.String" />
      <StartupScreenProgressBar ParameterType="System.String" />
      <StartupScreenProgressColor ParameterType="System.String" />
      <StartupScreenCorners ParameterType="System.String" />
      <StartupScreenMonitor ParameterType="System.String" />
      <StartupScreenTimeoutSeconds ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public sealed class ShenoraChromiumStampLauncher : Task
{
    [Required] public string Executable { get; set; }
    [Required] public string From { get; set; }
    public string StartupScreen { get; set; }
    public string StartupScreenWidth { get; set; }
    public string StartupScreenHeight { get; set; }
    public string StartupScreenBackground { get; set; }
    public string StartupScreenProgressBar { get; set; }
    public string StartupScreenProgressColor { get; set; }
    public string StartupScreenCorners { get; set; }
    public string StartupScreenMonitor { get; set; }
    public string StartupScreenTimeoutSeconds { get; set; }

    private const string ScreenResource = "SHENORA_STARTUP_SCREEN";
    private const string ImageResource = "SHENORA_STARTUP_IMAGE";
    private static readonly IntPtr RcData = (IntPtr)10;

    private static readonly IntPtr[] Types = { (IntPtr)3 /* RT_ICON */, (IntPtr)14 /* RT_GROUP_ICON */, (IntPtr)16 /* RT_VERSION */ };
    private const uint AsData = 0x2 | 0x20;   // LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE

    private sealed class Resource { public IntPtr Type; public int Id; public string Name; public ushort Language; public byte[] Data; }

    private delegate bool EnumNames(IntPtr module, IntPtr type, IntPtr name, IntPtr param);
    private delegate bool EnumLanguages(IntPtr module, IntPtr type, IntPtr name, ushort language, IntPtr param);

    [DllImport("kernel32", SetLastError = true, CharSet = CharSet.Unicode)] private static extern IntPtr LoadLibraryEx(string path, IntPtr file, uint flags);
    [DllImport("kernel32")] private static extern bool FreeLibrary(IntPtr module);
    [DllImport("kernel32", CharSet = CharSet.Unicode)] private static extern bool EnumResourceNames(IntPtr module, IntPtr type, EnumNames callback, IntPtr param);
    [DllImport("kernel32", CharSet = CharSet.Unicode)] private static extern bool EnumResourceLanguages(IntPtr module, IntPtr type, IntPtr name, EnumLanguages callback, IntPtr param);
    [DllImport("kernel32", CharSet = CharSet.Unicode)] private static extern IntPtr FindResourceEx(IntPtr module, IntPtr type, IntPtr name, ushort language);
    [DllImport("kernel32")] private static extern IntPtr LoadResource(IntPtr module, IntPtr info);
    [DllImport("kernel32")] private static extern IntPtr LockResource(IntPtr data);
    [DllImport("kernel32")] private static extern uint SizeofResource(IntPtr module, IntPtr info);
    [DllImport("kernel32", SetLastError = true, CharSet = CharSet.Unicode)] private static extern IntPtr BeginUpdateResource(string path, bool deleteExisting);
    [DllImport("kernel32", SetLastError = true, CharSet = CharSet.Unicode)] private static extern bool UpdateResource(IntPtr update, IntPtr type, IntPtr name, ushort language, byte[] data, uint size);
    [DllImport("kernel32", SetLastError = true)] private static extern bool EndUpdateResource(IntPtr update, bool discard);

    public override bool Execute()
    {
        // Absolute before any native call: a relative path is resolved by each API its own way (LoadLibraryEx by its
        // search order, not the project's folder), and the stamp failed with error 2 on a path the checks below found.
        Executable = Path.GetFullPath(Executable);
        From = Path.GetFullPath(From);
        if (!File.Exists(Executable) || !File.Exists(From)) { Log.LogMessage(MessageImportance.Low, "Nothing to stamp: {0} or {1} is missing.", Executable, From); return true; }
        var remove = Read(Executable, withData: false);
        var add = Read(From, withData: true);
        if (!string.IsNullOrEmpty(StartupScreen) && !AddStartupScreen(add)) return false;
        // A file just copied can be held for a moment by whatever scans new executables, and the update then fails
        // with a sharing error (110 measured once in a row of builds); the .NET SDK retries its apphost's for the same
        // reason. Only those errors are retried.
        for (var attempt = 1; ; attempt++)
        {
            var error = Stamp(remove, add);
            if (error == 0)
            {
                Log.LogMessage(MessageImportance.Low, "{0} now carries {1}'s icon and version and its startup screen, if any ({2} resource(s)).", Path.GetFileName(Executable), Path.GetFileName(From), add.Count);
                return true;
            }
            if (attempt == 5 || (error != 5 && error != 32 && error != 33 && error != 110))
            {
                Log.LogError("Giving {0} the app's icon, version and startup screen failed (error {1}).", Executable, error);
                return false;
            }
            Log.LogMessage(MessageImportance.Normal, "{0} is busy (error {1}); trying again.", Path.GetFileName(Executable), error);
            System.Threading.Thread.Sleep(200 * attempt);
        }
    }

    // The startup screen the shim draws (D103): its description, one key=value per line, and its picture, as RCDATA of the
    // launcher. The values were checked before the fetch (_ShenoraChromiumCheck); only what MSBuild cannot read is here.
    private bool AddStartupScreen(List<Resource> add)
    {
        var image = Path.GetFullPath(StartupScreen);
        byte[] png;
        try { png = File.ReadAllBytes(image); }
        catch (Exception error) { Log.LogError("ShenoraChromiumStartupScreen names {0}, which could not be read: {1}", image, error.Message); return false; }
        var signature = new byte[] { 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A };
        if (png.Length < signature.Length) { Log.LogError("ShenoraChromiumStartupScreen names {0}, which is not a PNG (too short).", image); return false; }
        for (var i = 0; i < signature.Length; i++)
            if (png[i] != signature[i]) { Log.LogError("ShenoraChromiumStartupScreen names {0}, which is not a PNG (it does not start as one).", image); return false; }
        var text = string.Join("\n", new[]
        {
            "width=" + Or(StartupScreenWidth, "480"),
            "height=" + Or(StartupScreenHeight, "300"),
            "background=" + Argb(Or(StartupScreenBackground, "#202020")),
            "progress_bar=" + (string.Equals(Or(StartupScreenProgressBar, "false"), "true", StringComparison.OrdinalIgnoreCase) ? "1" : "0"),
            "progress_color=" + Argb(Or(StartupScreenProgressColor, "#3B82F6")),
            "corners=" + Or(StartupScreenCorners, "Rounded").ToLowerInvariant(),
            "monitor=" + Or(StartupScreenMonitor, "Cursor").ToLowerInvariant(),
            "timeout_ms=" + (long.Parse(Or(StartupScreenTimeoutSeconds, "20")) * 1000),
        });
        add.Add(new Resource { Type = RcData, Name = ScreenResource, Language = 0, Data = System.Text.Encoding.UTF8.GetBytes(text) });
        add.Add(new Resource { Type = RcData, Name = ImageResource, Language = 0, Data = png });
        return true;
    }

    private static string Or(string value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    // "#RRGGBB" or "#AARRGGBB" (the # optional) as AARRGGBB, eight hex digits.
    private static string Argb(string color)
    {
        var hex = color.TrimStart('#');
        return (hex.Length == 6 ? "FF" + hex : hex).ToUpperInvariant();
    }

    // 0, or the Win32 error that stopped it; nothing is saved unless every step succeeded.
    private int Stamp(List<Resource> remove, List<Resource> add)
    {
        var update = BeginUpdateResource(Executable, false);
        if (update == IntPtr.Zero) return Marshal.GetLastWin32Error();
        var names = new List<IntPtr>();
        try
        {
            foreach (var r in remove) Write(update, r, null, names);
            foreach (var r in add) Write(update, r, r.Data, names);
        }
        catch (Win32Exception error)
        {
            EndUpdateResource(update, true);
            foreach (var n in names) Marshal.FreeHGlobal(n);
            return error.NativeErrorCode;
        }
        var saved = EndUpdateResource(update, false);
        var code = saved ? 0 : Marshal.GetLastWin32Error();
        foreach (var n in names) Marshal.FreeHGlobal(n);
        return code;
    }

    private static void Write(IntPtr update, Resource r, byte[] data, List<IntPtr> names)
    {
        var name = r.Name == null ? (IntPtr)r.Id : Marshal.StringToHGlobalUni(r.Name);
        if (r.Name != null) names.Add(name);
        if (!UpdateResource(update, r.Type, name, r.Language, data, data == null ? 0u : (uint)data.Length))
            throw new Win32Exception(Marshal.GetLastWin32Error());
    }

    // A resource named by a string keeps its string: the pointer the enumeration hands over dies with the call.
    private static List<Resource> Read(string path, bool withData)
    {
        var found = new List<Resource>();
        var module = LoadLibraryEx(path, IntPtr.Zero, AsData);
        if (module == IntPtr.Zero) return found;
        try
        {
            foreach (var type in Types)
            {
                EnumResourceNames(module, type, (m, t, name, p) =>
                {
                    var isId = ((long)name >> 16) == 0;
                    var id = isId ? (int)(long)name : 0;
                    var text = isId ? null : Marshal.PtrToStringUni(name);
                    EnumResourceLanguages(m, t, name, (m2, t2, n2, language, p2) =>
                    {
                        var r = new Resource { Type = type, Id = id, Name = text, Language = language };
                        if (withData)
                        {
                            var info = FindResourceEx(m2, t2, n2, language);
                            var size = SizeofResource(m2, info);
                            r.Data = new byte[size];
                            Marshal.Copy(LockResource(LoadResource(m2, info)), r.Data, 0, (int)size);
                        }
                        found.Add(r);
                        return true;
                    }, IntPtr.Zero);
                    return true;
                }, IntPtr.Zero);
            }
        }
        finally { FreeLibrary(module); }
        return found;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Windows: CEF's launcher is built CET-compatible, with strict context-IP validation, so a shell extension that raises
       and handles its own exception under the app (a context-menu handler, on a right-click in a file picker) resumes at
       an address the shadow-stack check refuses, and Windows ends the whole process: fail-fast 0xc0000409, parameter 0x30
       (FAST_FAIL_SET_CONTEXT_DENIED). The PE's extended DLL characteristics, a 4-byte payload of its debug directory
       (IMAGE_DEBUG_TYPE_EX_DLLCHARACTERISTICS), take IMAGE_DLLCHARACTERISTICS_EX_CET_SET_CONTEXT_IP_VALIDATION_RELAXED_MODE
       (0x4): the shadow stack stays on, only that check is relaxed. A launcher with no such entry is not CET-compatible,
       has no strict mode to relax, and is left as it is. Written in place, so the file's size and layout do not change. -->
  <UsingTask TaskName="ShenoraChromiumRelaxContextIp" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <!-- A method, not a fragment: a fragment cannot return early. -->
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        const uint RelaxedMode = 0x4;
        const int ExDllCharacteristics = 20;   // IMAGE_DEBUG_TYPE_EX_DLLCHARACTERISTICS
        var path = System.IO.Path.GetFullPath(Executable);
        if (!System.IO.File.Exists(path)) { Log.LogMessage(MessageImportance.Low, "Nothing to relax: {0} is missing.", path); return true; }
        // A file just stamped can be held for a moment by whatever scans new executables; only that is retried.
        for (var attempt = 1; ; attempt++)
        {
            try
            {
                using (var stream = new System.IO.FileStream(path, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite, System.IO.FileShare.Read))
                using (var reader = new System.IO.BinaryReader(stream))
                {
                    stream.Position = 0x3c;
                    var pe = reader.ReadInt32();
                    stream.Position = pe;
                    if (reader.ReadUInt32() != 0x4550) { Log.LogWarning("{0} is not a PE file; its context-IP validation was left as it is.", path); return true; }
                    stream.Position = pe + 6;
                    var sections = reader.ReadUInt16();
                    stream.Position = pe + 20;
                    var optionalSize = reader.ReadUInt16();
                    var optional = pe + 24;
                    stream.Position = optional;
                    var magic = reader.ReadUInt16();
                    var directories = optional + (magic == 0x20b ? 112 : 96);
                    stream.Position = directories + 6 * 8;   // the debug directory
                    var debugRva = reader.ReadUInt32();
                    var debugSize = reader.ReadUInt32();
                    if (debugRva == 0) return true;

                    var table = optional + optionalSize;
                    long Offset(uint rva)
                    {
                        for (var i = 0; i < sections; i++)
                        {
                            stream.Position = table + i * 40 + 8;
                            var virtualSize = reader.ReadUInt32();
                            var virtualAddress = reader.ReadUInt32();
                            var rawSize = reader.ReadUInt32();
                            var rawPointer = reader.ReadUInt32();
                            if (rva >= virtualAddress && rva < virtualAddress + System.Math.Max(virtualSize, rawSize)) return rva - virtualAddress + rawPointer;
                        }
                        return -1;
                    }
                    var entries = Offset(debugRva);
                    if (entries < 0) return true;
                    for (var i = 0; i < debugSize / 28; i++)
                    {
                        stream.Position = entries + i * 28 + 12;
                        var type = reader.ReadUInt32();
                        var size = reader.ReadUInt32();
                        stream.Position += 4;   // AddressOfRawData
                        var data = reader.ReadUInt32();
                        if (type != ExDllCharacteristics || size < 4 || data == 0) continue;
                        stream.Position = data;
                        var flags = reader.ReadUInt32();
                        if ((flags & RelaxedMode) == 0)
                        {
                            stream.Position = data;
                            new System.IO.BinaryWriter(stream).Write(flags | RelaxedMode);
                        }
                        Log.LogMessage(MessageImportance.Low, "{0} has its context-IP validation relaxed (extended DLL characteristics 0x{1:X}).", System.IO.Path.GetFileName(path), flags | RelaxedMode);
                        return true;
                    }
                }
                return true;
            }
            catch (System.IO.IOException) when (attempt < 5)
            {
                System.Threading.Thread.Sleep(200 * attempt);
            }
        }
      }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Every refusal runs BEFORE the fetch, so a build that cannot be laid out never downloads 165 MB first. -->
  <Target Name="_ShenoraChromiumCheck">
    <Error Condition="'$(ShenoraChromiumEnginePath)' != '' and '$(ShenoraChromiumEnginePlatform)' != '' and '$(ShenoraChromiumEnginePlatform)' != '$(ShenoraCefPlatform)'"
           Text="The engine at $(ShenoraChromiumEnginePath) is a build for $(ShenoraChromiumEnginePlatform), and this app's RuntimeIdentifier '$(RuntimeIdentifier)' needs CEF's '$(ShenoraCefPlatform)'. Reference the engine package that matches the RuntimeIdentifier, or build for the one it carries." />
    <!-- The startup screen's options (D103), each refused by the name of the property that is wrong; the shim draws it on
         Windows only. -->
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and !Exists('$(ShenoraChromiumStartupScreen)')"
           Text="ShenoraChromiumStartupScreen names $(ShenoraChromiumStartupScreen), which does not exist. It is the PNG the startup screen shows, a path relative to the project or an absolute one." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenWidth)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenWidth)', '^[1-9][0-9]{0,4}$'))"
           Text="ShenoraChromiumStartupScreenWidth must be a positive whole number of device-independent pixels, not '$(ShenoraChromiumStartupScreenWidth)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenHeight)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenHeight)', '^[1-9][0-9]{0,4}$'))"
           Text="ShenoraChromiumStartupScreenHeight must be a positive whole number of device-independent pixels, not '$(ShenoraChromiumStartupScreenHeight)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenTimeoutSeconds)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenTimeoutSeconds)', '^[1-9][0-9]{0,5}$'))"
           Text="ShenoraChromiumStartupScreenTimeoutSeconds must be a positive whole number, not '$(ShenoraChromiumStartupScreenTimeoutSeconds)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenBackground)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenBackground)', '^#?([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$'))"
           Text="ShenoraChromiumStartupScreenBackground must be #RRGGBB or #AARRGGBB, not '$(ShenoraChromiumStartupScreenBackground)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenProgressColor)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenProgressColor)', '^#?([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$'))"
           Text="ShenoraChromiumStartupScreenProgressColor must be #RRGGBB or #AARRGGBB, not '$(ShenoraChromiumStartupScreenProgressColor)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenProgressBar)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenProgressBar)', '^(?i:true|false)$'))"
           Text="ShenoraChromiumStartupScreenProgressBar must be true or false, not '$(ShenoraChromiumStartupScreenProgressBar)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenCorners)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenCorners)', '^(?i:rounded|square)$'))"
           Text="ShenoraChromiumStartupScreenCorners must be Rounded or Square, not '$(ShenoraChromiumStartupScreenCorners)'." />
    <Error Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumStartupScreenMonitor)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShenoraChromiumStartupScreenMonitor)', '^(?i:cursor|primary)$'))"
           Text="ShenoraChromiumStartupScreenMonitor must be Cursor or Primary, not '$(ShenoraChromiumStartupScreenMonitor)'." />
    <Warning Condition="'$(ShenoraChromiumStartupScreen)' != '' and '$(ShenoraChromiumLayout)' == 'true' and '$(ShenoraCefPlatform)' != '' and !$(ShenoraCefPlatform.StartsWith('windows'))"
             Text="ShenoraChromiumStartupScreen is drawn on Windows only, so this $(RuntimeIdentifier) app shows none." />
    <Error Condition="'$(ShenoraChromiumEnginePath)' != '' and !Exists('$(ShenoraCefDist)\Release')"
           Text="ShenoraChromiumEnginePath names $(ShenoraCefDist), which has no Release\ folder of CEF's." />
    <Error Condition="'$(ShenoraCefPlatform)' == ''"
           Text="Shenora.Chromium needs a RuntimeIdentifier CEF publishes a build for (win-x64, win-arm64, osx-x64, osx-arm64, linux-x64, linux-arm64); this build has '$(RuntimeIdentifier)'. Set &lt;RuntimeIdentifier&gt; in the app's project." />
    <Error Condition="!$(AssemblyName.EndsWith('.App'))"
           Text="A Shenora.Chromium app's own assembly must be named '&lt;App&gt;.App' (this one is '$(AssemblyName)'): CEF's launcher runs as &lt;App&gt;.exe and loads &lt;App&gt;.dll, the kit's shim, which starts &lt;App&gt;.App.dll. Set &lt;AssemblyName&gt;$(AssemblyName).App&lt;/AssemblyName&gt;." />
    <Error Condition="!Exists('$(ShenoraChromiumShim)')" Text="The kit's native half for $(RuntimeIdentifier) is missing at $(ShenoraChromiumShim). The package carries it for win-x64, win-arm64, osx-x64, osx-arm64, linux-x64 and linux-arm64; in this repo, `node devtools/dev.mjs cef-native --rid $(RuntimeIdentifier)` builds and stages it (a macOS RID on a Mac, a Linux RID on Linux)." />
  </Target>

  <Target Name="ShenoraChromiumFetchCef" DependsOnTargets="_ShenoraChromiumCheck" Condition="'$(ShenoraChromiumLayout)' == 'true'">
    <ItemGroup>
      <_ShenoraCefPick Include="@(ShenoraCefDistribution)" Condition="'%(Identity)' == '$(ShenoraCefPlatform)'" />
    </ItemGroup>
    <PropertyGroup>
      <_ShenoraCefFile>@(_ShenoraCefPick->'%(File)')</_ShenoraCefFile>
      <_ShenoraCefSha1>@(_ShenoraCefPick->'%(Sha1)')</_ShenoraCefSha1>
      <_ShenoraCefPart>$(_ShenoraCefFile).$(_ShenoraCefRun).part</_ShenoraCefPart>
      <_ShenoraCefArchive>$([System.IO.Path]::Combine('$(ShenoraCefRoot)', '$(_ShenoraCefPart)'))</_ShenoraCefArchive>
      <_ShenoraCefStaging>dist.$(_ShenoraCefRun)</_ShenoraCefStaging>
      <_ShenoraCefNeeded Condition="!Exists('$(ShenoraCefDist)')">true</_ShenoraCefNeeded>
    </PropertyGroup>
    <Error Condition="'$(_ShenoraCefFile)' == ''" Text="The pinned CEF build $(ShenoraCefBuild) names no distribution for $(ShenoraCefPlatform)." />

    <MakeDir Condition="'$(_ShenoraCefNeeded)' == 'true'" Directories="$(ShenoraCefRoot)" />
    <DownloadFile Condition="'$(_ShenoraCefNeeded)' == 'true'"
                  SourceUrl="https://cef-builds.spotifycdn.com/$([System.Uri]::EscapeDataString('$(_ShenoraCefFile)'))"
                  DestinationFolder="$(ShenoraCefRoot)" DestinationFileName="$(_ShenoraCefPart)" />
    <ShenoraCefSha1 Condition="'$(_ShenoraCefNeeded)' == 'true'" File="$(_ShenoraCefArchive)">
      <Output TaskParameter="Hash" PropertyName="_ShenoraCefActual" />
    </ShenoraCefSha1>
    <Delete Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefActual)' != '$(_ShenoraCefSha1)'" Files="$(_ShenoraCefArchive)" />
    <Error Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefActual)' != '$(_ShenoraCefSha1)'"
           Text="The CEF download failed its SHA-1 check: got $(_ShenoraCefActual), the pin says $(_ShenoraCefSha1). The file was deleted; the next build downloads it again." />

    <!-- Relative paths from inside the cache, so a GNU tar (a POSIX host) never reads `D:\…` as a remote host. -->
    <MakeDir Condition="'$(_ShenoraCefNeeded)' == 'true'" Directories="$(ShenoraCefRoot)\$(_ShenoraCefStaging)" />
    <Exec Condition="'$(_ShenoraCefNeeded)' == 'true'" ContinueOnError="true" WorkingDirectory="$(ShenoraCefRoot)"
          Command="$(_ShenoraTar) -xjf &quot;$(_ShenoraCefPart)&quot; --strip-components=1 -C $(_ShenoraCefStaging)">
      <Output TaskParameter="ExitCode" PropertyName="_ShenoraCefTar" />
    </Exec>
    <Delete Condition="'$(_ShenoraCefNeeded)' == 'true'" Files="$(_ShenoraCefArchive)" />
    <RemoveDir Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefTar)' != '0'" Directories="$(ShenoraCefRoot)\$(_ShenoraCefStaging)" />
    <Error Condition="'$(_ShenoraCefNeeded)' == 'true' and '$(_ShenoraCefTar)' != '0'" Text="Extracting the CEF build failed (tar exited $(_ShenoraCefTar)); nothing was kept, so the next build starts again." />
    <!-- Linux: CEF's libcef.so carries its debug information, 1,183 of its 1,455 MB at CEF 154 (272 MB stripped, and the
         shell ran the same on both), which no app ships. Stripped once, here in the cache, with ShenoraChromiumStrip
         (binutils' strip by default; `false` keeps it whole), and kept whole, with a warning, where it cannot be. -->
    <Exec Condition="'$(_ShenoraCefNeeded)' == 'true' and $(ShenoraCefPlatform.StartsWith('linux')) and '$(ShenoraChromiumStrip)' != 'false'"
          ContinueOnError="true" WorkingDirectory="$(ShenoraCefRoot)" Command="$(ShenoraChromiumStrip) $(_ShenoraCefStaging)/Release/libcef.so">
      <Output TaskParameter="ExitCode" PropertyName="_ShenoraCefStripped" />
    </Exec>
    <Warning Condition="'$(_ShenoraCefNeeded)' == 'true' and $(ShenoraCefPlatform.StartsWith('linux')) and '$(ShenoraChromiumStrip)' != 'false' and '$(_ShenoraCefStripped)' != '0'"
             Text="libcef.so keeps its debug information, about 1.2 GB of it: `$(ShenoraChromiumStrip)` exited $(_ShenoraCefStripped). Install binutils, or set ShenoraChromiumStrip to a strip of this machine's, and delete $(ShenoraCefRoot) to fetch it again; or set it to false to keep the symbols." />
    <ShenoraCefPublish Condition="'$(_ShenoraCefNeeded)' == 'true'" Source="$(ShenoraCefRoot)\$(_ShenoraCefStaging)" Destination="$(ShenoraCefDist)" />
  </Target>

  <Target Name="_ShenoraChromiumLayoutInputs" DependsOnTargets="ShenoraChromiumFetchCef;_ShenoraChromiumLayoutItems" />

  <!-- What a layout copies, from $(ShenoraCefDist): no fetch here, so a layout entered through the MSBuild task (after
       the fetch ran) or a test over a fake distribution can compute it. -->
  <Target Name="_ShenoraChromiumLayoutItems">
    <PropertyGroup>
      <_ShenoraAppExe>$(AssemblyName.Substring(0, $([MSBuild]::Subtract($(AssemblyName.Length), 4))))</_ShenoraAppExe>
      <!-- A GUI app gets the GUI launcher, a console app the console one; the shim answers both. -->
      <_ShenoraBootstrap Condition="'$(OutputType)' == 'WinExe'">bootstrap.exe</_ShenoraBootstrap>
      <_ShenoraBootstrap Condition="'$(OutputType)' != 'WinExe'">bootstrapc.exe</_ShenoraBootstrap>
    </PropertyGroup>
    <ItemGroup>
      <_ShenoraCefRuntime Include="$(ShenoraCefDist)\Release\*.dll;$(ShenoraCefDist)\Release\*.bin;$(ShenoraCefDist)\Release\*.json" />
      <_ShenoraCefResources Include="$(ShenoraCefDist)\Resources\**\*" />
    </ItemGroup>
    <ShenoraChromiumLocaleFilter Condition="'$(ShenoraChromiumLocales)' != ''" Files="@(_ShenoraCefResources)" Locales="$(ShenoraChromiumLocales)">
      <Output TaskParameter="Dropped" ItemName="_ShenoraCefDroppedLocale" />
      <Output TaskParameter="Missing" PropertyName="_ShenoraMissingLocales" />
    </ShenoraChromiumLocaleFilter>
    <ItemGroup>
      <_ShenoraCefResources Remove="@(_ShenoraCefDroppedLocale)" />
    </ItemGroup>
    <Warning Condition="'$(_ShenoraMissingLocales)' != ''"
             Text="ShenoraChromiumLocales names $(_ShenoraMissingLocales), for which CEF $(ShenoraCefBuild) has no locale: CEF's names are like en-GB, zh-CN, pt-BR and fr." />
  </Target>

  <Target Name="ShenoraChromiumLayout" AfterTargets="Build" DependsOnTargets="ShenoraChromiumFetchCef" Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('windows'))">
    <!-- _ShenoraWindowsPublish=false spelled out: the task passes the build's global properties on, and a build is
         never the folders shape and never cleans. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ShenoraChromiumWindowsInto" Properties="_ShenoraWindowsInto=$(OutDir);_ShenoraWindowsPublish=false" />
  </Target>

  <Target Name="ShenoraChromiumPublishLayout" AfterTargets="Publish" DependsOnTargets="ShenoraChromiumFetchCef" Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('windows'))">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ShenoraChromiumWindowsInto" Properties="_ShenoraWindowsInto=$(PublishDir);_ShenoraWindowsPublish=true" />
  </Target>

  <!-- The Windows layout into $(_ShenoraWindowsInto), a build's output or a publish's, entered through the MSBuild task
       because a build and its publish each need it once. A publish with ShenoraChromiumPublishFolders puts CEF in
       engine\ (chrome_elf.dll stays at the root: CEF's launcher imports it) and reads the app from lib\; otherwise,
       and in every build, all of it sits beside the app. -->
  <Target Name="_ShenoraChromiumWindowsInto" DependsOnTargets="_ShenoraChromiumLayoutItems">
    <PropertyGroup>
      <_ShenoraFolders Condition="'$(_ShenoraWindowsPublish)' == 'true' and '$(ShenoraChromiumPublishFolders)' == 'true'">true</_ShenoraFolders>
      <_ShenoraEngineInto Condition="'$(_ShenoraFolders)' == 'true'">$(_ShenoraWindowsInto)engine\</_ShenoraEngineInto>
      <_ShenoraEngineInto Condition="'$(_ShenoraFolders)' != 'true'">$(_ShenoraWindowsInto)</_ShenoraEngineInto>
      <_ShenoraAppInto Condition="'$(_ShenoraFolders)' == 'true'">$(_ShenoraWindowsInto)lib\</_ShenoraAppInto>
      <_ShenoraAppInto Condition="'$(_ShenoraFolders)' != 'true'">$(_ShenoraWindowsInto)</_ShenoraAppInto>
    </PropertyGroup>
    <ItemGroup>
      <_ShenoraCefElf Include="@(_ShenoraCefRuntime)" Condition="'%(Filename)%(Extension)' == 'chrome_elf.dll'" />
      <_ShenoraCefEngine Include="@(_ShenoraCefRuntime)" Exclude="@(_ShenoraCefElf)" />
    </ItemGroup>
    <!-- A publish into a folder that still holds the OTHER shape, the option switched since: the SDK's incremental clean
         removes only what it wrote, never CEF, and the shim prefers engine\ and lib\ when they hold its files, so a
         leftover would run. Only CEF's own file names go (every locale, filtered or not), and in a flat publish the
         app's assembly in lib\; then the folders they leave empty. -->
    <ItemGroup Condition="'$(_ShenoraWindowsPublish)' == 'true'">
      <_ShenoraCefAllResources Include="$(ShenoraCefDist)\Resources\**\*" />
      <_ShenoraLeftover Condition="'$(_ShenoraFolders)' == 'true'"
                        Include="@(_ShenoraCefEngine->'$(_ShenoraWindowsInto)%(Filename)%(Extension)');@(_ShenoraCefAllResources->'$(_ShenoraWindowsInto)%(RecursiveDir)%(Filename)%(Extension)')" />
      <_ShenoraLeftover Condition="'$(_ShenoraFolders)' != 'true'"
                        Include="@(_ShenoraCefRuntime->'$(_ShenoraWindowsInto)engine\%(Filename)%(Extension)');@(_ShenoraCefAllResources->'$(_ShenoraWindowsInto)engine\%(RecursiveDir)%(Filename)%(Extension)');$(_ShenoraWindowsInto)lib\$(AssemblyName).dll" />
    </ItemGroup>
    <Delete Condition="'$(_ShenoraWindowsPublish)' == 'true'" Files="@(_ShenoraLeftover)" />
    <ItemGroup Condition="'$(_ShenoraWindowsPublish)' == 'true'">
      <_ShenoraLeftInLocales Include="$(_ShenoraWindowsInto)locales\**" />
      <_ShenoraLeftInEngine Include="$(_ShenoraWindowsInto)engine\**" />
      <_ShenoraLeftInLib Include="$(_ShenoraWindowsInto)lib\**" />
    </ItemGroup>
    <RemoveDir Condition="'$(_ShenoraWindowsPublish)' == 'true' and '$(_ShenoraFolders)' == 'true' and '@(_ShenoraLeftInLocales)' == ''" Directories="$(_ShenoraWindowsInto)locales" />
    <RemoveDir Condition="'$(_ShenoraWindowsPublish)' == 'true' and '$(_ShenoraFolders)' != 'true' and '@(_ShenoraLeftInEngine)' == ''" Directories="$(_ShenoraWindowsInto)engine" />
    <RemoveDir Condition="'$(_ShenoraWindowsPublish)' == 'true' and '$(_ShenoraFolders)' != 'true' and '@(_ShenoraLeftInLib)' == ''" Directories="$(_ShenoraWindowsInto)lib" />
    <Copy SourceFiles="@(_ShenoraCefEngine)" DestinationFolder="$(_ShenoraEngineInto)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShenoraCefElf)" DestinationFolder="$(_ShenoraWindowsInto)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShenoraCefResources)" DestinationFolder="$(_ShenoraEngineInto)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraCefDist)\Release\$(_ShenoraBootstrap)" DestinationFiles="$(_ShenoraWindowsInto)$(_ShenoraAppExe).exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraChromiumShim)" DestinationFiles="$(_ShenoraWindowsInto)$(_ShenoraAppExe).dll" SkipUnchangedFiles="true" />
    <ShenoraChromiumStampLauncher Executable="$(_ShenoraWindowsInto)$(_ShenoraAppExe).exe" From="$(_ShenoraAppInto)$(AssemblyName).dll"
                                  StartupScreen="$(ShenoraChromiumStartupScreen)" StartupScreenWidth="$(ShenoraChromiumStartupScreenWidth)"
                                  StartupScreenHeight="$(ShenoraChromiumStartupScreenHeight)" StartupScreenBackground="$(ShenoraChromiumStartupScreenBackground)"
                                  StartupScreenProgressBar="$(ShenoraChromiumStartupScreenProgressBar)" StartupScreenProgressColor="$(ShenoraChromiumStartupScreenProgressColor)"
                                  StartupScreenCorners="$(ShenoraChromiumStartupScreenCorners)" StartupScreenMonitor="$(ShenoraChromiumStartupScreenMonitor)"
                                  StartupScreenTimeoutSeconds="$(ShenoraChromiumStartupScreenTimeoutSeconds)" />
    <!-- After the stamp, which rewrites the file. ShenoraChromiumRelaxContextIp=false keeps CEF's strict validation. -->
    <ShenoraChromiumRelaxContextIp Condition="'$(ShenoraChromiumRelaxContextIp)' != 'false'" Executable="$(_ShenoraWindowsInto)$(_ShenoraAppExe).exe" />
  </Target>

  <!-- A self-contained app is built with the .NET apphost, because the SDK requires one; it is not published, since the
       app's exe is CEF's launcher and an apphost beside it would start the app with no Chromium sandbox. Declared ahead of
       the folders target below, so it never moves into lib\. -->
  <Target Name="_ShenoraChromiumDropApphost" AfterTargets="ComputeFilesToPublish"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and '$(SelfContained)' == 'true' and $(ShenoraCefPlatform.StartsWith('windows'))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == '$(AssemblyName).exe'" />
    </ItemGroup>
  </Target>

  <!-- ShenoraChromiumPublishFolders: everything the SDK publishes goes into lib\. Its own item list, rewritten once the
       list is complete and before it copies, rather than files moved after: `dotnet publish -o` makes PublishDir
       global, so it cannot be pointed at lib\ itself. Complete means after ComputeFilesToPublish: a deps file the SDK
       regenerates (a PackageReference with Publish="false", a runtime store) joins the list in
       GeneratePublishDependencyFile, after ComputeResolvedFilesToPublishList. -->
  <Target Name="_ShenoraChromiumPublishIntoLib" AfterTargets="ComputeFilesToPublish"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and '$(ShenoraChromiumPublishFolders)' == 'true' and ($(ShenoraCefPlatform.StartsWith('windows')) or $(ShenoraCefPlatform.StartsWith('linux')))">
    <ItemGroup>
      <ResolvedFileToPublish>
        <RelativePath>lib$([System.IO.Path]::DirectorySeparatorChar)%(ResolvedFileToPublish.RelativePath)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Linux: the .NET apphost's embedded path to the app's assembly (the SDK writes `<App>.App.dll`) rewritten to a path
       below the apphost's folder, for a publish with ShenoraChromiumPublishFolders, whose app is in lib/. The apphost keeps
       the path in one 1024-byte buffer, NUL-terminated, and looks for the runtime beside the app it names (measured: a
       self-contained app's runtime is found in lib/). Nothing found, or found twice, is an error, so a changed apphost
       fails the build rather than starting nothing. -->
  <UsingTask TaskName="ShenoraChromiumPointApphost" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String" Required="true" />
      <From ParameterType="System.String" Required="true" />
      <To ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        const int BufferSize = 1024;
        var path = System.IO.Path.GetFullPath(Executable);
        var bytes = System.IO.File.ReadAllBytes(path);
        var old = System.Text.Encoding.UTF8.GetBytes(From + "\0");
        var next = System.Text.Encoding.UTF8.GetBytes(To + "\0");
        int Find(byte[] what, int from)
        {
            for (var i = from; i <= bytes.Length - what.Length; i++)
            {
                var j = 0;
                while (j < what.Length && bytes[i + j] == what[j]) j++;
                if (j == what.Length) return i;
            }
            return -1;
        }
        var at = Find(old, 0);
        if (at < 0) { Log.LogError("{0} does not carry the app path '{1}' the SDK embeds in its apphost, so it cannot be pointed at '{2}'.", path, From, To); return false; }
        if (Find(old, at + 1) >= 0) { Log.LogError("{0} carries the app path '{1}' more than once, so which one the apphost reads is not known.", path, From); return false; }
        if (next.Length > BufferSize || at + next.Length > bytes.Length) { Log.LogError("The app path '{0}' does not fit the apphost's {1}-byte buffer.", To, BufferSize); return false; }
        // Beyond the old string the buffer is zero; anything else there is not the apphost this knows.
        for (var i = old.Length; i < next.Length; i++)
            if (bytes[at + i] != 0) { Log.LogError("{0}'s embedded app path is followed by data, so '{1}' does not fit after it.", path, To); return false; }
        System.Array.Clear(bytes, at, old.Length);
        System.Array.Copy(next, 0, bytes, at, next.Length);
        System.IO.File.WriteAllBytes(path, bytes);
        return true;
      }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Linux, flat as Windows': CEF's runtime and resources beside the app, the .NET apphost also as <App>, and the kit's
       helper as <App>-helper, which every CEF subprocess runs (Chromium's zygote forks it, so it runs no .NET). -->
  <Target Name="ShenoraChromiumLinuxLayout" AfterTargets="Build" DependsOnTargets="_ShenoraChromiumLayoutInputs"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('linux'))">
    <!-- _ShenoraLinuxPublish=false spelled out, as the Windows layout's is: the task passes the build's global properties on. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ShenoraChromiumLinuxInto" Properties="_ShenoraLinuxInto=$(OutDir);_ShenoraLinuxPublish=false" />
  </Target>

  <Target Name="ShenoraChromiumLinuxPublishLayout" AfterTargets="Publish"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('linux'))">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ShenoraChromiumLinuxInto" Properties="_ShenoraLinuxInto=$(PublishDir);_ShenoraLinuxPublish=true" />
  </Target>

  <!-- The Linux layout into $(_ShenoraLinuxInto), a build's output or a publish's. A publish with
       ShenoraChromiumPublishFolders puts CEF's runtime and the helper in engine/ (the helper loads libcef.so from its own
       folder, and CEF reads its resources from beside it: no rpath is needed), the app in lib/, and <App> alone at the
       root, its apphost pointed at lib/. Otherwise, and in every build, all of it sits beside the app. -->
  <Target Name="_ShenoraChromiumLinuxInto" DependsOnTargets="_ShenoraChromiumLayoutInputs">
    <PropertyGroup>
      <_ShenoraFolders Condition="'$(_ShenoraLinuxPublish)' == 'true' and '$(ShenoraChromiumPublishFolders)' == 'true'">true</_ShenoraFolders>
      <_ShenoraEngineInto Condition="'$(_ShenoraFolders)' == 'true'">$(_ShenoraLinuxInto)engine/</_ShenoraEngineInto>
      <_ShenoraEngineInto Condition="'$(_ShenoraFolders)' != 'true'">$(_ShenoraLinuxInto)</_ShenoraEngineInto>
      <_ShenoraAppInto Condition="'$(_ShenoraFolders)' == 'true'">$(_ShenoraLinuxInto)lib/</_ShenoraAppInto>
      <_ShenoraAppInto Condition="'$(_ShenoraFolders)' != 'true'">$(_ShenoraLinuxInto)</_ShenoraAppInto>
    </PropertyGroup>
    <ItemGroup>
      <_ShenoraCefLinuxRuntime Include="$(ShenoraCefDist)/Release/*" />
    </ItemGroup>
    <!-- A publish into a folder that still holds the OTHER shape, the option switched since: the SDK's incremental clean
         removes only what it wrote, never CEF, and the app finds engine/ before its own folder, so a leftover would run.
         Only CEF's own file names, the helper and the apphost under the assembly's name go (every locale, filtered or not;
         the SDK's clean leaves that apphost, though it removes the dlls), then the folders they leave empty. -->
    <ItemGroup Condition="'$(_ShenoraLinuxPublish)' == 'true'">
      <_ShenoraCefAllResources Include="$(ShenoraCefDist)/Resources/**/*" />
      <_ShenoraLeftover Condition="'$(_ShenoraFolders)' == 'true'"
                        Include="@(_ShenoraCefLinuxRuntime->'$(_ShenoraLinuxInto)%(Filename)%(Extension)');@(_ShenoraCefAllResources->'$(_ShenoraLinuxInto)%(RecursiveDir)%(Filename)%(Extension)');$(_ShenoraLinuxInto)$(_ShenoraAppExe)-helper;$(_ShenoraLinuxInto)$(AssemblyName)" />
      <_ShenoraLeftover Condition="'$(_ShenoraFolders)' != 'true'"
                        Include="@(_ShenoraCefLinuxRuntime->'$(_ShenoraLinuxInto)engine/%(Filename)%(Extension)');@(_ShenoraCefAllResources->'$(_ShenoraLinuxInto)engine/%(RecursiveDir)%(Filename)%(Extension)');$(_ShenoraLinuxInto)engine/$(_ShenoraAppExe)-helper;$(_ShenoraLinuxInto)lib/$(AssemblyName).dll" />
    </ItemGroup>
    <Delete Condition="'$(_ShenoraLinuxPublish)' == 'true'" Files="@(_ShenoraLeftover)" />
    <ItemGroup Condition="'$(_ShenoraLinuxPublish)' == 'true'">
      <_ShenoraLeftInLocales Include="$(_ShenoraLinuxInto)locales/**" />
      <_ShenoraLeftInEngine Include="$(_ShenoraLinuxInto)engine/**" />
      <_ShenoraLeftInLib Include="$(_ShenoraLinuxInto)lib/**" />
    </ItemGroup>
    <RemoveDir Condition="'$(_ShenoraLinuxPublish)' == 'true' and '$(_ShenoraFolders)' == 'true' and '@(_ShenoraLeftInLocales)' == ''" Directories="$(_ShenoraLinuxInto)locales" />
    <RemoveDir Condition="'$(_ShenoraLinuxPublish)' == 'true' and '$(_ShenoraFolders)' != 'true' and '@(_ShenoraLeftInEngine)' == ''" Directories="$(_ShenoraLinuxInto)engine" />
    <RemoveDir Condition="'$(_ShenoraLinuxPublish)' == 'true' and '$(_ShenoraFolders)' != 'true' and '@(_ShenoraLeftInLib)' == ''" Directories="$(_ShenoraLinuxInto)lib" />
    <Copy SourceFiles="@(_ShenoraCefLinuxRuntime)" DestinationFolder="$(_ShenoraEngineInto)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShenoraCefResources)" DestinationFolder="$(_ShenoraEngineInto)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraChromiumShim)" DestinationFiles="$(_ShenoraEngineInto)$(_ShenoraAppExe)-helper" SkipUnchangedFiles="true" />
    <!-- <App> is the apphost the SDK published, copied every time: a folders publish points it at lib/ below, and a flat one
         over it must replace that. In the folders shape the SDK's own copy in lib/ goes, the one apphost being the root's. -->
    <Copy SourceFiles="$(_ShenoraAppInto)$(AssemblyName)" DestinationFiles="$(_ShenoraLinuxInto)$(_ShenoraAppExe)" />
    <Delete Condition="'$(_ShenoraFolders)' == 'true'" Files="$(_ShenoraAppInto)$(AssemblyName)" />
    <ShenoraChromiumPointApphost Condition="'$(_ShenoraFolders)' == 'true'" Executable="$(_ShenoraLinuxInto)$(_ShenoraAppExe)"
                                 From="$(AssemblyName).dll" To="lib/$(AssemblyName).dll" />
    <!-- A NuGet package keeps no Unix permissions, so the helper arrives from one without its executable bit. -->
    <Exec Command="chmod 755 &quot;$(_ShenoraLinuxInto)$(_ShenoraAppExe)&quot; &quot;$(_ShenoraEngineInto)$(_ShenoraAppExe)-helper&quot;" />
  </Target>

  <!-- An Info.plist, the one piece of a bundle the build has to write rather than copy. -->
  <UsingTask TaskName="ShenoraMacPlist" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Executable ParameterType="System.String" Required="true" />
      <Identifier ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <Helper ParameterType="System.Boolean" />
      <IconFile ParameterType="System.String" />
      <DisplayName ParameterType="System.String" />
      <Copyright ParameterType="System.String" />
      <!-- A plist of the app's own whose top-level entries are merged in (ShenoraChromiumInfoPlist). -->
      <Entries ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <!-- A method, not a fragment: a fragment's Execute answers true whatever it logged, so a refused entry printed
           an error and the build still passed (measured). -->
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        string E(string s) => System.Security.SecurityElement.Escape(s);
        var entries = new System.Collections.Generic.List<System.Collections.Generic.KeyValuePair<string, string>>();
        void Add(string key, string value) => entries.Add(new System.Collections.Generic.KeyValuePair<string, string>(key, value));
        void Text(string key, string value) { if (!string.IsNullOrEmpty(value)) Add(key, "<string>" + E(value) + "</string>"); }
        Text("CFBundleExecutable", Executable);
        Text("CFBundleIdentifier", Identifier);
        Text("CFBundleName", Executable);
        Text("CFBundleDisplayName", DisplayName);
        Text("CFBundleIconFile", IconFile);
        Text("NSHumanReadableCopyright", Copyright);
        Text("CFBundlePackageType", "APPL");
        Text("CFBundleShortVersionString", Version);
        Text("CFBundleVersion", Version);
        Text("LSMinimumSystemVersion", "12.0");
        Add("NSHighResolutionCapable", "<true/>");
        if (Helper) Add("LSUIElement", "<true/>"); else Add("NSSupportsAutomaticGraphicsSwitching", "<true/>");

        // The app's own entries, such as the document types and URL schemes it opens: each replaces the key of the same
        // name, except the three that make the bundle what it is.
        if (!string.IsNullOrEmpty(Entries))
        {
          var doc = new System.Xml.XmlDocument();
          using (var reader = System.Xml.XmlReader.Create(Entries, new System.Xml.XmlReaderSettings { DtdProcessing = System.Xml.DtdProcessing.Ignore }))
            doc.Load(reader);
          var dict = doc.DocumentElement != null && doc.DocumentElement.Name == "plist" ? doc.DocumentElement.SelectSingleNode("dict") : null;
          if (dict == null) Log.LogError(Entries + " is not a property list with a dictionary at its top (<plist><dict>...</dict></plist>).");
          else
          {
            string key = null;
            foreach (System.Xml.XmlNode node in dict.ChildNodes)
            {
              if (!(node is System.Xml.XmlElement element)) continue;
              if (key == null)
              {
                if (element.Name == "key") { key = element.InnerText; continue; }
                Log.LogError(Entries + ": a <" + element.Name + "> where a <key> belongs.");
                break;
              }
              var name = key;
              key = null;
              if (name == "CFBundleExecutable" || name == "CFBundlePackageType")
                Log.LogError(Entries + " sets " + name + ", which the layout writes: the bundle runs the app's own executable.");
              else if (name == "CFBundleIdentifier")
                Log.LogError(Entries + " sets CFBundleIdentifier, which is ShenoraChromiumBundleId: set that instead.");
              else
              {
                var at = entries.FindIndex(p => p.Key == name);
                var pair = new System.Collections.Generic.KeyValuePair<string, string>(name, element.OuterXml);
                if (at >= 0) entries[at] = pair; else entries.Add(pair);
              }
            }
          }
        }
        if (!Log.HasLoggedErrors)
        {
          var plist = new System.Text.StringBuilder()
            .Append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
            .Append("<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n")
            .Append("<plist version=\"1.0\">\n<dict>\n");
          foreach (var pair in entries) plist.Append("  <key>").Append(E(pair.Key)).Append("</key>").Append(pair.Value).Append('\n');
          plist.Append("</dict>\n</plist>\n");
          System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(File));
          System.IO.File.WriteAllText(File, plist.ToString());
        }
        return !Log.HasLoggedErrors;
      }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- macOS: <App>.app, after Build from the build output, and after Publish from the publish folder, which for a
       self-contained publish holds the runtime too, so the app starts from Finder with no .NET installed. -->
  <Target Name="ShenoraChromiumMacLayout" AfterTargets="Build" DependsOnTargets="_ShenoraChromiumMacBundle"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('macos'))" />

  <!-- A target runs once per build and Build ran first, so the publish layout re-enters the project for the one
       target, naming its source. -->
  <Target Name="ShenoraChromiumMacPublishLayout" AfterTargets="Publish"
          Condition="'$(ShenoraChromiumLayout)' == 'true' and $(ShenoraCefPlatform.StartsWith('macos'))">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ShenoraChromiumMacBundle" Properties="_ShenoraMacFrom=$(PublishDir)" />
  </Target>

  <!-- CEF finds its framework and helpers by the bundle's shape, so the shape is the contract. -->
  <Target Name="_ShenoraChromiumMacBundle" DependsOnTargets="ShenoraChromiumFetchCef">
    <PropertyGroup>
      <!-- Set by the publish layout; the build output otherwise. -->
      <_ShenoraMacFrom Condition="'$(_ShenoraMacFrom)' == ''">$(OutDir)</_ShenoraMacFrom>
      <_ShenoraAppExe>$(AssemblyName.Substring(0, $([MSBuild]::Subtract($(AssemblyName.Length), 4))))</_ShenoraAppExe>
      <!-- In a folder of its own: macOS's file system ignores case, so <App>.app beside the <App>.App apphost is the
           same name (measured: the bundle's folders could not be created). -->
      <_ShenoraBundleDir>$(_ShenoraMacFrom)bundle/</_ShenoraBundleDir>
      <_ShenoraBundle>$(_ShenoraBundleDir)$(_ShenoraAppExe).app</_ShenoraBundle>
      <_ShenoraContents>$(_ShenoraBundle)/Contents</_ShenoraContents>
      <!-- Letters, digits, dots and hyphens only, which is all a bundle identifier may hold. -->
      <ShenoraChromiumBundleId Condition="'$(ShenoraChromiumBundleId)' == ''">com.shenora.app.$([System.Text.RegularExpressions.Regex]::Replace('$(_ShenoraAppExe)', '[^A-Za-z0-9.-]', '-'))</ShenoraChromiumBundleId>
      <_ShenoraBundleVersion>$(Version)</_ShenoraBundleVersion>
      <_ShenoraBundleVersion Condition="'$(_ShenoraBundleVersion)' == ''">1.0.0</_ShenoraBundleVersion>
    </PropertyGroup>
    <ItemGroup>
      <!-- The app's output, except the bundle this target makes inside it. -->
      <_ShenoraAppFiles Include="$(_ShenoraMacFrom)**/*" Exclude="$(_ShenoraBundleDir)**" />
      <_ShenoraCefFramework Include="$(ShenoraCefDist)/Release/Chromium Embedded Framework.framework/**/*" />
      <!-- The five helpers Chromium starts its subprocess types from, all the same binary. -->
      <_ShenoraHelper Include="helper" Variant="" />
      <_ShenoraHelper Include="helper.gpu" Variant=" (GPU)" />
      <_ShenoraHelper Include="helper.renderer" Variant=" (Renderer)" />
      <_ShenoraHelper Include="helper.plugin" Variant=" (Plugin)" />
      <_ShenoraHelper Include="helper.alerts" Variant=" (Alerts)" />
    </ItemGroup>
    <ShenoraChromiumLocaleFilter Condition="'$(ShenoraChromiumLocales)' != ''" Files="@(_ShenoraCefFramework)" Locales="$(ShenoraChromiumLocales)">
      <Output TaskParameter="Dropped" ItemName="_ShenoraCefDroppedLocale" />
      <Output TaskParameter="Missing" PropertyName="_ShenoraMissingLocales" />
    </ShenoraChromiumLocaleFilter>
    <ItemGroup>
      <_ShenoraCefFramework Remove="@(_ShenoraCefDroppedLocale)" />
    </ItemGroup>
    <Warning Condition="'$(_ShenoraMissingLocales)' != ''"
             Text="ShenoraChromiumLocales names $(_ShenoraMissingLocales), for which CEF $(ShenoraCefBuild) has no locale: CEF's names are like en-GB, zh-CN, pt-BR and fr." />
    <Copy SourceFiles="@(_ShenoraAppFiles)" DestinationFolder="$(_ShenoraContents)/MacOS/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_ShenoraMacFrom)$(AssemblyName)" DestinationFiles="$(_ShenoraContents)/MacOS/$(_ShenoraAppExe)" SkipUnchangedFiles="true" />
    <!-- The app's icon, an .icns (ShenoraChromiumBundleIcon), in the bundle's Resources where CFBundleIconFile names it:
         without one the Dock and Finder show a generic app. The Windows layout takes ApplicationIcon instead. -->
    <Copy Condition="'$(ShenoraChromiumBundleIcon)' != ''" SourceFiles="$(ShenoraChromiumBundleIcon)"
          DestinationFiles="$(_ShenoraContents)/Resources/$(_ShenoraAppExe).icns" SkipUnchangedFiles="true" />
    <PropertyGroup>
      <_ShenoraBundleIconFile Condition="'$(ShenoraChromiumBundleIcon)' != ''">$(_ShenoraAppExe).icns</_ShenoraBundleIconFile>
      <!-- The SDK defaults Product to the assembly's name, which is no name a person should see. -->
      <_ShenoraBundleDisplayName Condition="'$(Product)' != '$(AssemblyName)'">$(Product)</_ShenoraBundleDisplayName>
      <!-- The app's own Info.plist entries (ShenoraChromiumInfoPlist): the document types and URL schemes macOS routes
           to it, a usage description the OS asks it for. Relative to the project. -->
      <_ShenoraInfoPlistEntries Condition="'$(ShenoraChromiumInfoPlist)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ShenoraChromiumInfoPlist)'))</_ShenoraInfoPlistEntries>
    </PropertyGroup>
    <ShenoraMacPlist File="$(_ShenoraContents)/Info.plist" Executable="$(_ShenoraAppExe)" Identifier="$(ShenoraChromiumBundleId)" Version="$(_ShenoraBundleVersion)"
                     IconFile="$(_ShenoraBundleIconFile)" DisplayName="$(_ShenoraBundleDisplayName)" Copyright="$(Copyright)"
                     Entries="$(_ShenoraInfoPlistEntries)" />
    <Copy SourceFiles="@(_ShenoraCefFramework)" DestinationFolder="$(_ShenoraContents)/Frameworks/Chromium Embedded Framework.framework/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ShenoraChromiumShim)" DestinationFiles="$(_ShenoraContents)/Frameworks/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant).app/Contents/MacOS/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant)" SkipUnchangedFiles="true" />
    <!-- A NuGet package keeps no Unix permissions, so the helper arrives from one without its executable bit. -->
    <Exec Command="chmod 755 &quot;$(_ShenoraContents)/Frameworks/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant).app/Contents/MacOS/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant)&quot;" />
    <ShenoraMacPlist File="$(_ShenoraContents)/Frameworks/$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant).app/Contents/Info.plist"
                     Executable="$(_ShenoraAppExe) Helper%(_ShenoraHelper.Variant)" Identifier="$(ShenoraChromiumBundleId).%(_ShenoraHelper.Identity)"
                     Version="$(_ShenoraBundleVersion)" Helper="true" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Chromium engine (D81-D84): the kit's own Chromium shell on CEF's Views framework, and the embedding a
    host that owns its UI thread uses (D83). Its own package id, because an app that chose WebView2 must not
    carry CEF (D81); CEF's bytes never ship in it, the app's build fetches them.

    Interop/Generated/ is written by `node devtools/dev.mjs cef-binding` from the pin in cef.json and
    is never edited by hand. Common/ is what every OS shares. The rest differs by OS (window and event
    handles, main args, platform thread ids, wchar_t), and Common references those types by name, so a
    build compiles Common plus exactly ONE OS folder. CefOs picks it from the runtime identifier and
    defaults to Windows; `-p:CefOs=Linux` compile-checks another OS from this machine.
  -->
  <PropertyGroup>
    <!-- IsPackable stays INLINE — the coverage gate finds shipped projects by text-matching it. -->
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.Chromium</PackageId>
    <Description>Shenora's Chromium engine, through CEF, for an app that ships its own browser engine instead of WebView2. UseChromium is a shell of the kit's own: CEF's windows with frameless chrome, real caption buttons and Snap Layouts, file drops with real paths, native file dialogs, the clipboard, a tray, secondary windows, crash reload and dev-server hot reload, with IPC over a transport that needs no code in the renderer. ChromiumEngine and ChromiumChildBrowser embed a page in a window the host owns, which is how Shenora.Windows hosts one beside its WebView2 control. ChromiumBrowserProcess runs Chromium as a browser of its own, in a second process of the app's executable: Chromium's own windows and a debugging port for an agent's tools, with no app page in reach of it. CEF itself is not in the package: the app's build fetches the pinned CEF build, checks its SHA-1, and lays the app out, on Windows beside CEF's launcher with the kit's shim, which is what gives Chromium its sandbox, and on macOS as an app bundle whose helpers sandbox each subprocess. Reference it from the app's own project, with a RuntimeIdentifier and an assembly named &lt;App&gt;.App. Windows (x64, arm64) and macOS (x64, arm64), where the build makes an app bundle.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- An app's RuntimeIdentifier reaches this project only because it is NOT rid-agnostic: the SDK strips the RID
         from a reference to a library that is, and a macOS app then got the Windows binding (measured). -->
    <IsRidAgnostic>false</IsRidAgnostic>
    <CefOs Condition="'$(CefOs)' == '' and $(RuntimeIdentifier.StartsWith('osx'))">MacOS</CefOs>
    <CefOs Condition="'$(CefOs)' == '' and $(RuntimeIdentifier.StartsWith('linux'))">Linux</CefOs>
    <CefOs Condition="'$(CefOs)' == ''">Windows</CefOs>
    <!-- CEF_WINDOWS / CEF_MACOS / CEF_LINUX, for the few call sites whose C types differ (main args). -->
    <DefineConstants>$(DefineConstants);CEF_$(CefOs.ToUpperInvariant())</DefineConstants>
    <ShimArtifacts Condition="'$(ShimArtifacts)' == ''">$(MSBuildThisFileDirectory)artifacts\</ShimArtifacts>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Interop/Generated/Windows/**;Interop/Generated/MacOS/**;Interop/Generated/Linux/**" />
    <Compile Include="Interop/Generated/$(CefOs)/**/*.cs" />
    <None Include="cef.json" />
    <!-- Beside the binaries it covers: the binding is a derivative of CEF's BSD headers, and the shim links nethost. -->
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <!-- The app-build targets, which fetch CEF from its own published builds (D81) and lay the app out beside
         CEF's launcher. build/ and never buildTransitive/: NuGet keeps a dependency's build/ private by default,
         so an app gets the engine only by referencing this package itself, and a Shenora.Windows app, which
         depends on it (D83), does not. -->
    <None Include="build\*.targets" Pack="true" PackagePath="build\" />
    <!-- The shim, staged by `dev.mjs cef-native` and never committed. Packed into tools/, not runtimes/, which NuGet
         would copy into every app's output as a stray file beside the <App>.dll the targets copy it to; and not a
         folder of its own, where NuGet refuses (NU5100) a .dll outside lib/. -->
    <None Include="$(ShimArtifacts)runtimes\**\native\*" Pack="true" PackagePath="tools\" />
    <!-- The macOS binding, compiled as CefOs=MacOS and staged by `dev.mjs pack`: NuGet gives an app built for a
         RID the assets under runtimes/<rid>/lib over lib/, which is the Windows binding. ONE copy, under runtimes/osx,
         which osx-x64 and osx-arm64 both fall back to: a Windows app built with no RID carries every runtimes/ copy,
         and it carried two (measured). -->
    <None Include="$(ShimArtifacts)runtimes\**\lib\**\*.dll" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>

  <!-- A package without the shim restores fine and fails at the consumer's build, so packing one fails here. -->
  <Target Name="RequireShimArtifacts" BeforeTargets="GenerateNuspec">
    <!-- lib/net10.0 is the Windows build; macOS's binding rides under runtimes/. A pack of another OS would put its
         struct layouts in lib/. -->
    <Error Condition="'$(CefOs)' != 'Windows'"
           Text="Shenora.Chromium packs the Windows build as lib/; this build is CefOs=$(CefOs)." />
    <ItemGroup>
      <_ShenoraRequiredArtifact Include="$(ShimArtifacts)runtimes\win-x64\native\shenora_chromium_shim.dll" Hint="node devtools/dev.mjs cef-native" />
      <_ShenoraRequiredArtifact Include="$(ShimArtifacts)runtimes\win-arm64\native\shenora_chromium_shim.dll" Hint="node devtools/dev.mjs cef-native --rid win-arm64" />
      <_ShenoraRequiredArtifact Include="$(ShimArtifacts)runtimes\osx-x64\native\shenora_chromium_helper" Hint="node devtools/dev.mjs cef-native --rid osx-x64, on a Mac" />
      <_ShenoraRequiredArtifact Include="$(ShimArtifacts)runtimes\osx-arm64\native\shenora_chromium_helper" Hint="node devtools/dev.mjs cef-native --rid osx-arm64, on a Mac" />
      <_ShenoraRequiredArtifact Include="$(ShimArtifacts)runtimes\osx\lib\net10.0\Shenora.Chromium.dll" Hint="node devtools/dev.mjs pack" />
    </ItemGroup>
    <Error Condition="!Exists('%(_ShenoraRequiredArtifact.Identity)')"
           Text="Shenora.Chromium is missing %(_ShenoraRequiredArtifact.Identity). `%(_ShenoraRequiredArtifact.Hint)` stages it there." />
  </Target>

  <ItemGroup>
    <!-- The kit's portable core: IPC, the resource pipeline a shell implements (D45), the runner seam. -->
    <ProjectReference Include="..\Shenora\Shenora.csproj" />
  </ItemGroup>

</Project>

<Project>
  <!-- Central package versions for the whole tree (the root Directory.Packages.props imports this
       file so tests/samples share one version list). No Version= ever appears on a PackageReference. -->
  <ItemGroup>
    <!-- Core dependencies. Abstractions for the contracts; the DI IMPLEMENTATION is needed by the
         builder (BuildServiceProvider lives there, not in Abstractions) — same shape as
         Microsoft.Extensions.Hosting itself. Recorded in docs/DECISIONS.md D17. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />

    <!-- WebView2 (version proven across the sibling apps) -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />

    <!-- MAUI: the OLDEST version the mobile shells support, because this is the floor Shenora.Android and
         Shenora.iOS ship, and the one the kit compiles against, so nothing newer can creep in. Never
         $(MauiVersion): that is the packing machine's workload, and 0.17.0 shipped requiring the 10.0.110
         the release runner had just installed. An app on a newer workload still gets its own version. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.20" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.WebView2</PackageId>
    <!-- The WebView2 package always references its WPF assembly, whose WindowsBase differs from a
         WinForms-only project's — MSB3277 fires but the WPF dll is never loaded here. Demote it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <Description>Shenora WebView2 hosting: environment prewarm and creation, dev-server vs packaged-frontend loading (embedded resources or virtual host), navigation/new-window/download/permission/process-failure handling, runtime presence check, and the postMessage bridge with batched event push.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Ipc\Shenora.Ipc.csproj" />
    <!-- D19: the two Windows packages are ONE layer — Windows PRIMITIVES (WinForms) and web hosting
         on top of them. This edge replaced the old "never sideways" rule on evidence: the UI-thread
         marshal pattern had been hand-rolled 14 times across three packages with five incompatible
         pre-handle policies, two of them buggy. It adds no new TECHNOLOGY dependency — this project
         already sets UseWindowsForms and hosts the WebView2 WinForms control. WinForms must never
         reference this project back, and it deliberately still carries no Shenora.Ipc dependency. -->
    <ProjectReference Include="..\Shenora.WinForms\Shenora.WinForms.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

</Project>

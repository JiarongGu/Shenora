<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora.WebView2</PackageId>
    <!-- The WebView2 package always references its WPF assembly, whose WindowsBase differs from a
         WinForms-only project's — MSB3277 fires but the WPF dll is never loaded here. Demote it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <Description>Shenora WebView2 hosting: environment prewarm and creation, dev-server vs packaged-frontend loading (embedded resources or virtual host), navigation/new-window/download/permission/process-failure handling, runtime presence check, and the postMessage bridge with batched event push.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shenora.Ipc\Shenora.Ipc.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

</Project>

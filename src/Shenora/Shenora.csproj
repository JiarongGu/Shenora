<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Shenora</PackageId>
    <Description>Shenora core: desktop application host and builder (ShenoraApplication.CreateBuilder), lifecycle, module registration (IShenoraModule), environment and app-path services, event bus, and the platform-neutral shell contracts — the IUiDispatcher UI-thread seam plus file dialogs, clipboard, URL launching and UI blocking — so application logic compiles without a Windows reference. Depends on Microsoft.Extensions DI (implementation) + logging abstractions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DI IMPLEMENTATION (not just Abstractions) is required: the builder calls
         BuildServiceProvider, which lives there. D17. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>

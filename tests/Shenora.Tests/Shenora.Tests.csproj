<Project Sdk="Microsoft.NET.Sdk">

  <!-- tests/ sits OUTSIDE src/, so src/Directory.Build.props does not apply — the shared build
       properties are restated here on purpose (tests must never inherit packability). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodePage>65001</CodePage>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <!-- Same harmless WebView2-WPF WindowsBase conflict as Shenora.Windows — demote it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parallelization control (P5.5 H7). Declared explicitly rather than trusting xunit's
         auto-include glob — verified the hard way: the file alone did NOT reach the output directory,
         so the runner never read it, and a config the runner ignores is worse than none (it reads as
         control that isn't there). Check with:
             ls bin/Debug/net10.0-windows/xunit.runner.json
         WHY serial (see xunit.runner.json): this suite creates real STA message pumps, real OS
         mutexes and six real window threads, and asserts wall-clock budgets — collection-level
         parallelism made those race each other on a loaded box. It also actively HID a defect:
         WindowCommandFacadeTests' START_RESIZE case entered the OS modal size loop on the test
         thread for ~17 s (indefinitely when run alone), and overlapping work kept the wall clock at
         6 s so nobody saw it. Serial costs 6 s → 9 s and is steady. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- A miniature frontend bundle for the EmbeddedResourceProvider tests (manifest prefix
         Shenora.Tests.TestAssets.wwwroot). vendor.min.js exists to prove dotted FILE names
         resolve — the mis-map fixed relative to the source app. -->
    <EmbeddedResource Include="TestAssets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The file-operation engine and its zip half arrive through Shenora.Core: Shenora.IO and
         Shenora.IO.Compression stopped being packages on 2026-08-07 (D55). The NAMESPACES are
         unchanged, so every test using them still compiles untouched. -->
    <ProjectReference Include="..\..\src\Shenora.Windows\Shenora.Windows.csproj" />
    <!-- The desktop SAMPLE, so the cookie-login driver keeps its tests after moving out of the
         library (P7). It is a recipe now, not public surface — but its invariants are sibling
         post-mortems (a STALE auth cookie must not capture; closing a signed-out window must not
         produce an anonymous blob) and those are worth keeping green. -->
    <ProjectReference Include="..\..\samples\Shenora.Sample.Desktop\Shenora.Sample.Desktop.csproj" />
  </ItemGroup>

</Project>
